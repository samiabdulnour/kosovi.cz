---
// Kontakt in the type of O nás (Sami, November 2026): no page title under the
// header, the studio's name in capitals as a section name, then the phones,
// the e-mail and the note on visits in Claristik (.essay in base.css). No
// street address and no line on courses (Sami, November 2026).
import { studio } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { cz, telHref, typeset } from '../lib/typography';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  cs: {
    title: 'Kontakt',
    description: 'Kontakt na porcelánový ateliér Daniely a Martina Kosových v Praze.',
    // Sami, November 2026
    visitText: 'Návštěva dílny je možná pouze po telefonickém dohovoru.',
  },
  en: {
    title: 'Contact',
    description: 'Contact the porcelain studio of Daniela and Martin Kos in Prague.',
    visitText: 'Visits to the workshop by arrangement on the phone only.',
  },
}[lang];
---

<Base title={copy.title} description={copy.description} alternates={alternatesOf('contact')}>
  <h1 class="visually-hidden">{copy.title}</h1>
  <section class="wrap contact essay" aria-labelledby="atelier">
    <h2 id="atelier">{cz(studio.name)}</h2>
    <address>
      <p>
        {
          studio.phones.map((phone, i) => (
            <>
              {i > 0 && <br />}
              <a href={telHref(phone)}>{cz(phone)}</a>
            </>
          ))
        }
        <br />
        <a href={`mailto:${studio.email}`}>{studio.email}</a>
      </p>
    </address>
    <p class="visit">{typeset(copy.visitText, lang)}</p>
  </section>
</Base>

<style>
  /* where O nás puts its first section name */
  .contact {
    padding-block-start: calc(clamp(1.5rem, 4.5vw, 4.25rem) + clamp(2rem, 3.2vw, 3rem));
  }

  address {
    font-style: normal;
  }

  .visit {
    margin-block-start: calc(2 * var(--text) * var(--line));
  }
</style>
