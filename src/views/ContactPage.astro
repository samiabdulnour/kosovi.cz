---
import ContactBlock from '../components/ContactBlock.astro';
import Base from '../layouts/Base.astro';
import { alternatesOf, pathOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { typeset } from '../lib/typography';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  cs: {
    title: 'Kontakt',
    description: 'Kontakt na porcelánový ateliér Daniely a Martina Kosových v Praze.',
    // Sami, November 2026
    visitText: 'Návštěva dílny je možná pouze po telefonickém dohovoru.',
    courses: 'Kurzy keramiky a porcelánu na požádání.',
    coursesLink: 'Kurzy',
  },
  en: {
    title: 'Contact',
    description: 'Contact the porcelain studio of Daniela and Martin Kos in Prague.',
    visitText: 'Visits to the workshop by arrangement on the phone only.',
    courses: 'Ceramics and porcelain courses on request.',
    coursesLink: '',
  },
}[lang];
---

<Base title={copy.title} description={copy.description} alternates={alternatesOf('contact')} label={copy.title}>
  <div class="section wrap">
    <div class="stack">
      <ContactBlock />
      <p>
        {typeset(copy.courses, lang)}{' '}
        {lang === 'cs' && <a href={withBase(pathOf('courses', 'cs'))}>{copy.coursesLink}</a>}
      </p>
    </div>
    <p class="visit">{typeset(copy.visitText, lang)}</p>
  </div>
</Base>

<style>
  .visit {
    margin-block-start: var(--space-7);
  }
</style>
