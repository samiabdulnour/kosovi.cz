---
// A maker's page after docs/design/kosovi_daniela_martin.pdf (Sami, November
// 2026): the name on the label line, a composition of colour fields and two
// photographs across the whole width, then their pieces five a row on the
// e-shop's tiles, each opening its product page. Layout and photos in
// src/config/artists.ts.
import Composition from '../components/Composition.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Note from '../components/wire/Note.astro';
import { artistPages } from '../config/artists';
import { makers, type MakerKey } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { getProductsBySlug } from '../lib/products';

interface Props {
  maker: MakerKey;
  lang: Lang;
}

const { maker, lang } = Astro.props;
const person = makers[maker];
const design = artistPages[maker];

// Every piece must exist in the catalogue; a wrong slug stops the build.
const items = await getProductsBySlug(design.works.map((w) => w.product));
const works = design.works.map((w) => {
  const item = items.find((p) => p.slug === w.product);
  if (!item) throw new Error(`src/config/artists.ts: no product "${w.product}" for ${maker}`);
  const src = w.src ?? item.images[w.image ?? 0]?.src;
  if (!src) throw new Error(`src/config/artists.ts: "${w.product}" has no photo ${w.image ?? 0}`);
  return { ...w, src, item };
});

const description =
  lang === 'cs'
    ? `${person.name}: porcelán z ateliéru Daniely a Martina Kosových v Praze.`
    : `${person.name}: porcelain from the Kos studio in Prague.`;
---

<Base title={person.name} description={description} alternates={alternatesOf(maker)} label={person.name}>
  <Composition composition={design.composition} />

  <div class="wrap">
    <section class="works" aria-label={lang === 'cs' ? 'Výběr prací' : 'Selected work'}>
      <WorkGrid works={works} lang={lang} />
    </section>
    <Note>
      <p>
        Podle kosovi_daniela_martin.pdf. Martinovy dlaždice ukazují fotky výrobků z e-shopu (nové fotky, listopad 2026),
        Danieliny zatím fotky z PDF. Dlaždice vedou na stránky výrobků. Stránka volné tvorby ({maker === 'martin' ? '/martin-kos/volna-tvorba/' : '/daniela-kosova/volna-tvorba/'})
        sem zatím nevede.
      </p>
    </Note>
  </div>
</Base>

<style>
  .works {
    padding-block-start: clamp(3rem, 8.5vw, 8rem);
  }
</style>
