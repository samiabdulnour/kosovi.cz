---
// A maker's page after the design: two fields, "Volné" (their own art) and
// "Užité" (pieces for use, which opens their part of the e-shop).
import FieldBlock from '../components/FieldBlock.astro';
import Note from '../components/wire/Note.astro';
import { artistBlocks } from '../config/home';
import { getLine } from '../config/lines';
import { makers, type MakerKey } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf, collectionPath, pathOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { photoOf } from '../lib/photos';

interface Props {
  maker: MakerKey;
  lang: Lang;
}

const { maker, lang } = Astro.props;
const t = useTranslations(lang);
const person = makers[maker];
const line = getLine(maker);
const blocks = artistBlocks[maker];

const description =
  lang === 'cs'
    ? `${person.name}: volná tvorba a užité předměty z porcelánu.`
    : `${person.name}: fine art and porcelain for everyday use.`;
---

<Base title={person.name} description={description} alternates={alternatesOf(maker)} label={person.name}>
  <div class="wrap">
    <div class="pair">
      <FieldBlock
        href={withBase(pathOf(maker === 'martin' ? 'martinFree' : 'danielaFree', lang))}
        caption={t('artist.free')}
        field={blocks.free.field}
        photo={await photoOf(blocks.free)}
        captionAt="bottom"
        ratio="4 / 3"
      />
      <FieldBlock
        href={withBase(collectionPath(line.slug[lang], lang))}
        caption={t('artist.applied')}
        field={blocks.applied.field}
        photo={await photoOf(blocks.applied)}
        captionAt="bottom"
        ratio="4 / 3"
      />
    </div>
    <Note>
      <p>„Užité“ otevře {maker === 'martin' ? 'Martinovu' : 'Danielinu'} část e-shopu. „Volné“ vede na galerii volné tvorby, pro kterou zatím chybí fotografie.</p>
    </Note>
  </div>
</Base>

<style>
  .pair {
    display: grid;
    gap: var(--space-6) var(--gap);
  }

  @media (min-width: 48rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
