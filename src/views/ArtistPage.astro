---
import { Image } from 'astro:assets';
import ProductGrid from '../components/ProductGrid.astro';
import Note from '../components/wire/Note.astro';
import Placeholder from '../components/wire/Placeholder.astro';
import { danielaCollections, danielaFacts, martinFacts } from '../config/facts';
import { getLine } from '../config/lines';
import { makers, type MakerKey } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf, collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { getLineProducts } from '../lib/products';
import { typeset } from '../lib/typography';

interface Props {
  maker: MakerKey;
  lang: Lang;
}

const { maker, lang } = Astro.props;
const person = makers[maker];
const line = getLine(maker);
const products = await getLineProducts(maker);
const t = (text: string) => typeset(text, lang);

const facts = (maker === 'martin' ? martinFacts : danielaFacts)[lang];
const collections = maker === 'daniela' ? danielaCollections[lang] : [];

const copy = {
  cs: {
    description:
      maker === 'martin'
        ? 'Martin Kos točí porcelán na hrnčířském kruhu. Životopis, způsob práce a jeho kusy.'
        : 'Daniela Kosová maluje porcelán kobaltem a tvoří vlastní výtvarná díla. Životopis, způsob práce a její práce.',
    bio: 'Životopis',
    how: 'Jak pracuje',
    collections: 'Zastoupení ve sbírkách',
    pieces: maker === 'martin' ? 'Jeho kusy' : 'Její práce',
    all: `Všechny kusy v kolekci ${line.name.cs}`,
  },
  en: {
    description:
      maker === 'martin'
        ? 'Martin Kos throws porcelain on the potter’s wheel. Biography, how he works and his pieces.'
        : 'Daniela Kosová paints porcelain with cobalt and makes her own artwork. Biography, how she works and her pieces.',
    bio: 'Biography',
    how: maker === 'martin' ? 'How he works' : 'How she works',
    collections: 'Collections',
    pieces: maker === 'martin' ? 'His pieces' : 'Her work',
    all: `All pieces in the ${line.name.en} collection`,
  },
}[lang];

---

<Base title={person.name} description={copy.description} alternates={alternatesOf(maker)}>
  <section class="section wrap">
    <div class="split">
      <Image src={person.portrait.src} alt={person.portrait.alt} widths={[480, 800, 1152]} sizes="(min-width: 60rem) 50vw, 100vw" loading="eager" />
      <div class="stack">
        <h1>{person.name}</h1>
        <p class="lead">{t(person.role[lang])}</p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split">
      <div class="stack">
        <h2>{copy.bio}</h2>
        <ul class="facts">
          {facts.map((fact) => <li>{t(fact)}</li>)}
        </ul>
        {
          collections.length > 0 && (
            <>
              <h3>{copy.collections}</h3>
              <ul class="facts">
                {collections.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>
      <div class="stack">
        <h2>{copy.how}</h2>
        <Placeholder label={maker === 'martin' ? 'točení, krátké video' : 'malba kobaltem, krátké video'} kind="video" ratio="16 / 9" />
        <Note>
          <p>TODO(fakta): jak {maker === 'martin' ? 'Martin' : 'Daniela'} pracuje, vlastními slovy. Zatím jsou k dispozici jen fakta ze starého webu.</p>
          {
            maker === 'martin' && (
              <p>Ke schválení: Galerie Svatoš uvádí, že Martin je hrnčíř ve třetí generaci a dělá tenkostěnný porcelán s drobnými otvory, které dávají průsvitným šálkům krajkový vzor. Použít až po potvrzení.</p>
            )
          }
        </Note>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="section-head">{copy.pieces}</h2>
    <ProductGrid products={products} lang={lang} placeholders={8} limit={8} />
    <p class="after-grid">
      <a href={withBase(collectionPath(line.slug[lang], lang))}>{t(copy.all)}</a>
    </p>
    <Note>
      <p>Galerijní prezentace samostatné tvorby. Kde cena není stanovená, zobrazí se „cena na dotaz“.</p>
    </Note>
  </section>
</Base>

<style>
  .after-grid {
    margin-block-start: var(--space-5);
  }
</style>
