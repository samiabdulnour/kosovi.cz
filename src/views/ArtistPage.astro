---
// A maker's page (src/config/artists.ts), after kosovi_martin.pdf and
// kosovi_daniela.pdf (Sami, November 2026): the maker's e-shop categories as
// tabs in one row, where their listings and product pages have them (Sami,
// November 2026), then rows of photographs across the whole width, as on the
// homepage; no page title under the header.
import Mosaic from '../components/Mosaic.astro';
import ShopTabs from '../components/ShopTabs.astro';
import Note from '../components/wire/Note.astro';
import { artistPages } from '../config/artists';
import { getLine } from '../config/lines';
import { makers, type MakerKey } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf, pathOf } from '../i18n/routes';
import { withBase } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { getProductsBySlug } from '../lib/products';

interface Props {
  maker: MakerKey;
  lang: Lang;
}

const { maker, lang } = Astro.props;
const person = makers[maker];
const design = artistPages[maker];
const line = getLine(maker);

// A photo that opens a product needs the product; a wrong slug stops the build.
const wanted = design.rows.flatMap((row) => row.items.flatMap((i) => (i.product ? [i.product] : [])));
const found = await getProductsBySlug(wanted);
for (const slug of wanted) {
  if (!found.some((p) => p.slug === slug)) throw new Error(`src/config/artists.ts: no product "${slug}" for ${maker}`);
}

const description =
  lang === 'cs'
    ? `${person.name}: porcelán z ateliéru Daniely a Martina Kosových v Praze.`
    : `${person.name}: porcelain from the Kos studio in Prague.`;

const notes: Record<MakerKey, string> = {
  martin:
    'Podle kosovi_martin.pdf. Popisky se ukážou po najetí myší, fotky vedou do Martinových kategorií v e-shopu (vázy, konve a čajové soupravy, hrnky s razítkem). Tenkostěnné hrnky do žádné nepatří, zatím nikam nevedou.',
  daniela:
    'Podle kosovi_daniela.pdf. Popisky se ukážou po najetí myší. Obtisky a Obtisky na cibulák vedou do Danieliných kategorií v e-shopu, ostatní fotky zatím nikam, jejich kategorie přijdou později.',
};
---

<Base title={person.name} description={description} alternates={alternatesOf(maker)}>
  <h1 class="visually-hidden">{person.name}</h1>
  <div class="wrap tabs-row">
    <ShopTabs line={line} lang={lang} name={{ text: person.name, href: withBase(pathOf(maker, lang)), current: true }} />
  </div>
  <Mosaic rows={design.rows} lang={lang} />
  <div class="wrap">
    <Note>
      <p>{notes[maker]}</p>
    </Note>
  </div>
</Base>

<style>
  /* as on the e-shop's listings and product pages */
  .tabs-row {
    padding-block: clamp(2rem, 3.6vw, 3.4rem) clamp(2.5rem, 7.5vw, 7.5rem);
  }

  /* on phones the ochre band right under the header (ShopTabs) */
  @media (max-width: 47.99rem) {
    .tabs-row {
      padding-block: 0 2rem;
    }
  }
</style>
