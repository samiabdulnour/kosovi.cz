---
// E-shop overview: the three collections, blue and white porcelain first.
import FieldBlock from '../components/FieldBlock.astro';
import type { Field } from '../config/home';
import { lines, type LineKey } from '../config/lines';
import Base from '../layouts/Base.astro';
import { alternatesOf, collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { photoOf } from '../lib/photos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const covers: Record<LineKey, { product: string; field: Field }> = {
  spolecna: { product: 'porcelanovy-hrnek-pitny-rezim-s-capy', field: 'sky' },
  martin: { product: 'cajova-souprava-1', field: 'olive' },
  daniela: { product: 'talir-jidelni-3', field: 'peach' },
};

const blocks = await Promise.all(
  lines.map(async (line) => ({
    line,
    field: covers[line.key].field,
    photo: await photoOf(covers[line.key]),
  })),
);

const description =
  lang === 'cs'
    ? 'E-shop porcelánového ateliéru Daniely a Martina Kosových: modrobílý porcelán a užitá tvorba Martina Kose a Daniely Kosové.'
    : 'Shop of the Kos porcelain studio: blue and white porcelain and pieces by Martin Kos and Daniela Kosová.';
---

<Base title={t('nav.shop')} description={description} alternates={alternatesOf('collections')} label={t('nav.shop')}>
  <div class="wrap lines">
    {
      blocks.map(({ line, field, photo }) => (
        <FieldBlock href={withBase(collectionPath(line.slug[lang], lang))} caption={line.name[lang]} field={field} photo={photo} ratio="4 / 3" />
      ))
    }
  </div>
</Base>

<style>
  .lines {
    display: grid;
    gap: var(--space-6) var(--gap);
  }

  @media (min-width: 48rem) {
    .lines {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
