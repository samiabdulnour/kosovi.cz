---
// Homepage after the design kosovi_navrh_01.pdf: the photo strip, the claim,
// a selection of the blue and white porcelain and the two makers.
import { Image } from 'astro:assets';
import FieldBlock from '../components/FieldBlock.astro';
import PhotoBand, { type BandPhoto } from '../components/PhotoBand.astro';
import Note from '../components/wire/Note.astro';
import { artistBlocks, blueWhiteSelection, heroBand } from '../config/home';
import { getLine } from '../config/lines';
import { makers, studio } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf, collectionPath, pathOf, productPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { photoOf } from '../lib/photos';
import { getFeaturedProducts, getProductsBySlug } from '../lib/products';
import { typeset } from '../lib/typography';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const blueWhite = getLine('spolecna');
const shopPath = collectionPath(blueWhite.slug[lang], lang);

const copy = {
  cs: {
    description: 'Porcelánový ateliér Daniely a Martina Kosových v Praze. Modrobílé nádobí pro každý den a autorská díla obou výtvarníků.',
    // Homepage claim from the design.
    claim: 'Od modrobílého porcelánu pro každý den po autorská díla Daniely a Martina Kosových.',
  },
  en: {
    description: 'Porcelain studio of Daniela and Martin Kos in Prague. Blue and white tableware for every day and the artworks of both artists.',
    // TODO(text): working translation, final English copy in phase 6.
    claim: 'From blue and white porcelain for every day to the artworks of Daniela and Martin Kos.',
  },
}[lang];

const band: BandPhoto[] = [];
for (const item of heroBand) {
  const photo = await photoOf(item);
  if (photo) band.push({ ...photo, field: item.field, inset: item.inset });
}

const featured = (await getFeaturedProducts()).filter((p) => p.line === 'spolecna');
const selection = (featured.length >= 4 ? featured : await getProductsBySlug(blueWhiteSelection)).slice(0, 4);
const tileFields = ['honey', 'sky', 'honey', 'sky'] as const;

const people = await Promise.all(
  (['daniela', 'martin'] as const).map(async (key) => ({
    key,
    name: makers[key].name,
    href: pathOf(key, lang),
    field: artistBlocks[key].home.field,
    photo: await photoOf(artistBlocks[key].home),
  })),
);
---

<Base description={copy.description} alternates={alternatesOf('home')} label={studio.name}>
  <PhotoBand photos={band} lang={lang} />

  <div class="wrap">
    <p class="claim from-label">{typeset(copy.claim, lang)}</p>

    <section class="section">
      <h2 class="section-head"><a href={withBase(shopPath)}>{blueWhite.name[lang]}</a></h2>
      <ul class="tiles" role="list">
        {
          selection.map((product, i) => {
            const cover = product.images[0];
            return (
              <li>
                <a class="field field--contain" href={withBase(productPath(product.slug))} style={`--field: var(--field-${tileFields[i]})`}>
                  {cover && <Image src={cover.src} alt={cover.alt} widths={[320, 480, 720]} sizes="(min-width: 48rem) 22vw, 50vw" />}
                </a>
              </li>
            );
          })
        }
      </ul>
      <Note>
        <p>Výběr čtyř kusů, každý se otevře v e-shopu. TODO(rozhodnutí): vybere Sami (`featured: true` u produktu nebo seznam v src/config/home.ts).</p>
      </Note>
    </section>

    <section class="people">
      {
        people.map((person) => (
          <FieldBlock href={withBase(person.href)} caption={person.name} field={person.field} photo={person.photo} />
        ))
      }
    </section>
  </div>
</Base>

<style>
  .claim {
    padding-block: var(--space-4) var(--space-3);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .tiles .field {
    aspect-ratio: 4 / 3;
  }

  .people {
    display: grid;
    gap: var(--space-6) var(--gap);
    padding-block: var(--space-6);
  }

  @media (min-width: 48rem) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
    }

    .people {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
