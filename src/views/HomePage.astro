---
// Homepage after the second kosovi_homepage.pdf (Sami, November 2026): a row
// of two pictures on colour fields, then rows of photographs across the whole
// width, the first of them the blue-and-white porcelain on a green band. Each
// photograph opens its author's part of the site and shows the author's name
// on hover (src/components/Mosaic.astro, src/config/home.ts).
import Mosaic from '../components/Mosaic.astro';
import Note from '../components/wire/Note.astro';
import { mosaic, topRow } from '../config/home';
import { studio } from '../config/site';
import Base from '../layouts/Base.astro';
import { alternatesOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const description = {
  cs: 'Porcelánový ateliér Daniely a Martina Kosových v Praze. Modrobílé nádobí pro každý den a autorská díla obou výtvarníků.',
  en: 'Porcelain studio of Daniela and Martin Kos in Prague. Blue and white tableware for every day and the artworks of both artists.',
}[lang];
---

<Base description={description} alternates={alternatesOf('home')}>
  <h1 class="visually-hidden">{studio.name}</h1>
  <div class="lead">
    <Mosaic rows={[topRow, ...mosaic]} lang={lang} />
  </div>

  <div class="wrap">
    <Note>
      <p>
        Podle nového kosovi_homepage.pdf. Jméno autora se ukáže po najetí myší (na dotykových displejích je vidět stále),
        fotka vede na Danielinu nebo Martinovu stránku, nebo do e-shopu modrobílého porcelánu. Video a černé konvice nahoře
        nikam nevedou.
      </p>
    </Note>
  </div>
</Base>

<style>
  /* The first row 77 points under the header's baseline, as in the PDF. */
  .lead {
    margin-block-start: clamp(0.5rem, 2.85vw, 2.7rem);
  }
</style>
