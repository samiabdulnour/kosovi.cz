---
// E-shop listing after eshop.pdf: the line's name on the label line, the
// category menu, a rule across the page, then the products five a row with
// a large illustration and the page bar.
import type { Page } from 'astro';
import Pagination from '../components/Pagination.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Note from '../components/wire/Note.astro';
import type { Line, MenuItem } from '../config/lines';
import { ILLUSTRATION_MIN_PRODUCTS, shopIllustrations } from '../config/shop';
import Base from '../layouts/Base.astro';
import { collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { getEntryProducts, type Product } from '../lib/products';
import { formatCzk } from '../lib/typography';

interface Props {
  line: Line;
  lang: Lang;
  page: Page<Product>;
  /** A menu column heading or item; none lists the whole line. */
  entry?: MenuItem;
}

const { line, lang, page, entry } = Astro.props;
const lineName = line.name[lang];
const pathFor = (n: number) => collectionPath(line.slug[lang], lang, entry?.slug, n);

const pageSuffix = page.currentPage > 1 ? (lang === 'cs' ? `, strana ${page.currentPage}` : `, page ${page.currentPage}`) : '';
const title = `${entry ? `${entry.name} · ` : ''}${lineName}${pageSuffix}`;
const description =
  lang === 'cs'
    ? `${entry ? `${entry.name}, ` : ''}${lineName}. Ručně dělaný porcelán z ateliéru Daniely a Martina Kosových v Praze.`
    : `${entry ? `${entry.name}, ` : ''}${lineName}. Handmade porcelain from the Kos studio in Prague.`;

const alternates = {
  cs: collectionPath(line.slug.cs, 'cs', entry?.slug, page.currentPage),
  en: collectionPath(line.slug.en, 'en', entry?.slug, page.currentPage),
};

const isCurrent = (item: MenuItem) => (item.slug === entry?.slug ? 'page' : undefined);
const emptyItems = line.menu.flatMap((g) => g.items).filter((i) => i.match.length === 0);

// One illustration per page, taking turns when there are more of them.
const pool = shopIllustrations[line.key] ?? [];
const pick = pool[(page.currentPage - 1) % Math.max(pool.length, 1)];
let illustration;
if (pick && page.data.length >= ILLUSTRATION_MIN_PRODUCTS) {
  const target = line.menu.flatMap((g) => [g, ...g.items]).find((e) => e.slug === pick.entry);
  const prices = target ? (await getEntryProducts(line.key, target)).map((p) => p.price).filter((p) => p !== null) : [];
  const lowest = prices.length ? Math.min(...prices) : undefined;
  illustration = {
    src: pick.src,
    alt: pick.alt,
    caption: pick.caption,
    href: collectionPath(line.slug[lang], lang, pick.entry),
    price: lowest === undefined ? undefined : `${lang === 'cs' ? 'od' : 'from'} ${formatCzk(lowest)}`,
  };
}
---

<Base title={title} description={description} alternates={alternates} label={lineName}>
  <div class="wrap">
    <nav class="menu" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
      {
        line.menu.map((group) => (
          <div class="group">
            <h2>
              <a href={withBase(collectionPath(line.slug[lang], lang, group.slug))} aria-current={isCurrent(group)}>
                {group.name}
              </a>
            </h2>
            {group.items.length > 0 && (
              <ul role="list">
                {group.items.map((item) => (
                  <li>
                    <a href={withBase(collectionPath(line.slug[lang], lang, item.slug))} aria-current={isCurrent(item)}>
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </nav>
  </div>

  <hr class="rule" />

  <div class="wrap">
    <h2 class="list-head">{entry ? entry.name : lineName}</h2>
    <ProductGrid products={page.data} lang={lang} illustration={illustration} />
    <Pagination current={page.currentPage} last={page.lastPage} pathFor={pathFor} lang={lang} />

    {
      emptyItems.length > 0 && (
        <Note title="Kategorie bez produktů">
          <p>
            Z návrhu, ale ve starém e-shopu pro ně nejsou žádné kusy: {emptyItems.map((i) => i.name).join(', ')}. Ostatní kategorie jsou namapované na starý e-shop v src/config/lines.ts, sporné jsou „Hrnek malý“ (dřív „Mini“) a „Miska velká“ (dřív „Polévka/Snídaně“).
          </p>
        </Note>
      )
    }
  </div>
</Base>

<style>
  .menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow-wrap: anywhere;
    gap: var(--space-6) var(--gap);
    padding-block: var(--space-4) var(--space-6);
  }

  .menu ul {
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--color-ink);
  }

  .list-head {
    padding-block: var(--space-7) var(--space-4);
  }

  /* Columns on the design's lines: 0, 30 %, 60 % and the last one at the right. */
  @media (min-width: 48rem) {
    .menu {
      grid-template-columns: var(--label-start) var(--label-start) 1fr auto;
      column-gap: 0;
    }

    .group {
      padding-inline-end: var(--gap);
    }
  }
</style>
