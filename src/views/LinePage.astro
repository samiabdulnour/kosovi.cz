---
// E-shop listing. The blue-and-white line opens with an ochre band across the
// whole width (Sami's screen, November 2026): its name, the tabs and the size
// chart (ShopMenu), then the products. Martin's and Daniela's lines open with
// their tabs in one row, as on the product pages (Sami, November 2026). Other lines
// follow eshop.pdf: the line's name on the label line and the category menu
// in columns. Then the products five a row, with a large illustration on the
// line's own listing and in Ostatní, and the page numbers. Under them, on a
// light blue band as under a product page, pieces of the same kind from the other
// parts of the e-shop (src/config/crosslinks.ts, Sami, November 2026).
import type { Page } from 'astro';
import Pagination from '../components/Pagination.astro';
import ProductGrid from '../components/ProductGrid.astro';
import RelatedBand from '../components/RelatedBand.astro';
import ShopMenu from '../components/ShopMenu.astro';
import ShopTabs from '../components/ShopTabs.astro';
import Note from '../components/wire/Note.astro';
import { crossLinks } from '../config/crosslinks';
import { getLine, hasSizeChart, type Line, type MenuItem } from '../config/lines';
import { ILLUSTRATION_MIN_PRODUCTS, hasIllustration, illustrationsFor } from '../config/shop';
import Base from '../layouts/Base.astro';
import { collectionPath, pathOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { getCrossPieces, getEntryProducts, type Product } from '../lib/products';
import { formatCzk } from '../lib/typography';

interface Props {
  line: Line;
  lang: Lang;
  page: Page<Product>;
  /** A menu column heading or item; none lists the whole line. */
  entry?: MenuItem;
}

const { line, lang, page, entry } = Astro.props;
const lineName = line.name[lang];
const pathFor = (n: number) => collectionPath(line.slug[lang], lang, entry?.slug, n);

const pageSuffix = page.currentPage > 1 ? (lang === 'cs' ? `, strana ${page.currentPage}` : `, page ${page.currentPage}`) : '';
const title = `${entry ? `${entry.name} · ` : ''}${lineName}${pageSuffix}`;
const description =
  lang === 'cs'
    ? `${entry ? `${entry.name}, ` : ''}${lineName}. Ručně dělaný porcelán z ateliéru Daniely a Martina Kosových v Praze.`
    : `${entry ? `${entry.name}, ` : ''}${lineName}. Handmade porcelain from the Kos studio in Prague.`;

const alternates = {
  cs: collectionPath(line.slug.cs, 'cs', entry?.slug, page.currentPage),
  en: collectionPath(line.slug.en, 'en', entry?.slug, page.currentPage),
};

const isCurrent = (item: MenuItem) => (item.slug === entry?.slug ? 'page' : undefined);
const chart = hasSizeChart(line);
const tabs = !chart && line.tabs === true;
const group = line.menu.find((g) => g.slug === entry?.slug || g.items.some((i) => i.slug === entry?.slug));
const emptyItems = line.menu.flatMap((g) => g.items).filter((i) => i.match.length === 0);

// The large illustration: one per page, taking turns when there are more of
// them (src/config/shop.ts).
const pool = hasIllustration(line.key, entry?.slug) ? illustrationsFor(line.key, entry?.slug) : [];
const pick = pool[(page.currentPage - 1) % Math.max(pool.length, 1)];
let illustration;
if (pick && page.data.length >= ILLUSTRATION_MIN_PRODUCTS) {
  const target = line.menu.flatMap((g) => [g, ...g.items]).find((e) => e.slug === pick.entry);
  const prices = target ? (await getEntryProducts(line.key, target)).map((p) => p.price).filter((p) => p !== null) : [];
  const lowest = prices.length ? Math.min(...prices) : undefined;
  illustration = {
    src: pick.src,
    alt: pick.alt,
    caption: pick.caption,
    href: collectionPath(line.slug[lang], lang, pick.entry),
    price: lowest === undefined ? undefined : `${lang === 'cs' ? 'od' : 'from'} ${formatCzk(lowest)}`,
  };
}

// The other parts of the e-shop, by this listing's tab (a kind's listing
// takes its tab's). A heading opens the listing its pieces come from; a whole
// maker's line opens the maker's page.
// Up to three pages, each made like the first (three of Martin's and two of
// Daniela's, say), to page through with the band's arrows (Sami, November 2026).
const PAGES = 3;
const crossGroups = await Promise.all(
  (crossLinks[line.key][group?.slug ?? ''] ?? []).map(async (g) => {
    const to = g.link ?? g.from;
    const other = getLine(to.line);
    const href = to.entry
      ? collectionPath(other.slug[lang], lang, to.entry)
      : to.line === 'spolecna'
        ? collectionPath(other.slug[lang], lang)
        : pathOf(to.line, lang);
    return { title: g.title[lang], href: withBase(href), count: g.count, products: await getCrossPieces({ ...g, count: g.count * PAGES }) };
  }),
);
const cross = Array.from({ length: PAGES }, (_, i) =>
  crossGroups.map((g) => ({ title: g.title, href: g.href, products: g.products.slice(i * g.count, (i + 1) * g.count) })),
).flat();
---

<Base title={title} description={description} alternates={alternates} label={chart || tabs ? undefined : lineName}>
  {chart && <ShopMenu line={line} lang={lang} entry={entry} />}
  {
    tabs && (
      <>
        <h1 class="visually-hidden">{entry ? `${lineName}, ${entry.name}` : lineName}</h1>
        <div class="wrap tabs-row">
          <ShopTabs
            line={line}
            lang={lang}
            group={group}
            isPage={!!group && group.slug === entry?.slug}
            name={line.key === 'spolecna' ? undefined : { text: lineName, href: withBase(pathOf(line.key, lang)) }}
          />
        </div>
      </>
    )
  }
  <div class="wrap">
    {
      chart || tabs ? null : (
        <nav class="menu" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
          {
            line.menu.map((group) => (
              <div class="group">
                <h2>
                  <a href={withBase(collectionPath(line.slug[lang], lang, group.slug))} aria-current={isCurrent(group)}>
                    {group.name}
                  </a>
                </h2>
                {group.items.length > 0 && (
                  <ul role="list">
                    {group.items.map((item) => (
                      <li>
                        <a href={withBase(collectionPath(line.slug[lang], lang, item.slug))} aria-current={isCurrent(item)}>
                          {item.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </nav>
      )
    }

    {chart ? <div class="after-chart" /> : tabs ? null : <h2 class="list-head">{entry ? entry.name : lineName}</h2>}
    <ProductGrid products={page.data} lang={lang} illustration={illustration} />
    <Pagination current={page.currentPage} last={page.lastPage} pathFor={pathFor} lang={lang} />

    {
      emptyItems.length > 0 && (
        <Note title="Kategorie bez produktů">
          <p>
            Z návrhu, ale ve starém e-shopu pro ně nejsou žádné kusy: {emptyItems.map((i) => i.name).join(', ')}. Ostatní kategorie jsou namapované na starý e-shop v src/config/lines.ts, sporná je „Miska velká“ (dřív „Polévka/Snídaně“).
          </p>
        </Note>
      )
    }
  </div>

  {/* Less space above than under a product page, since the last row of
      products already ends in its row's space (Sami, November 2026): the page
      numbers midway between the products and the band. */}
  <RelatedBand
    groups={cross}
    label={lang === 'cs' ? 'Z dalších částí e-shopu' : 'From the other parts of the shop'}
    lang={lang}
    gap={page.lastPage > 1 ? 'clamp(3rem, 6.5vw, 6.25rem)' : 'var(--space-6)'}
  />
</Base>

<style>
  .menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow-wrap: anywhere;
    gap: var(--space-6) var(--gap);
    padding-block: var(--space-4) var(--space-6);
  }

  .menu ul {
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .list-head {
    padding-block: var(--space-7) var(--space-4);
  }

  /* as on the product pages */
  .tabs-row {
    padding-block: clamp(2rem, 3.6vw, 3.4rem) clamp(2.5rem, 7.5vw, 7.5rem);
  }

  /* on phones the ochre band right under the header (ShopTabs) */
  @media (max-width: 47.99rem) {
    .tabs-row {
      padding-block: 0 2rem;
    }
  }

  .after-chart {
    height: clamp(2rem, 3.2vw, 3rem);
  }

  /* Columns on the design's lines: 0, 30 %, 60 % and the last one at the right. */
  @media (min-width: 48rem) {
    .menu {
      grid-template-columns: var(--label-start) var(--label-start) 1fr auto;
      column-gap: 0;
    }

    .group {
      padding-inline-end: var(--gap);
    }
  }
</style>
