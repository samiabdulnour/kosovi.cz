---
// E-shop listing after the design: the category menu in four columns, twelve
// products a page and the page bar.
import type { Page } from 'astro';
import Pagination from '../components/Pagination.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Note from '../components/wire/Note.astro';
import type { Line, MenuItem } from '../config/lines';
import Base from '../layouts/Base.astro';
import { collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import type { Product } from '../lib/products';

interface Props {
  line: Line;
  lang: Lang;
  page: Page<Product>;
  /** A menu column heading or item; none lists the whole line. */
  entry?: MenuItem;
}

const { line, lang, page, entry } = Astro.props;
const lineName = line.name[lang];
const pathFor = (n: number) => collectionPath(line.slug[lang], lang, entry?.slug, n);

const pageSuffix = page.currentPage > 1 ? (lang === 'cs' ? `, strana ${page.currentPage}` : `, page ${page.currentPage}`) : '';
const title = `${entry ? `${entry.name} · ` : ''}${lineName}${pageSuffix}`;
const description =
  lang === 'cs'
    ? `${entry ? `${entry.name}, ` : ''}${lineName}. Ručně dělaný porcelán z ateliéru Daniely a Martina Kosových v Praze.`
    : `${entry ? `${entry.name}, ` : ''}${lineName}. Handmade porcelain from the Kos studio in Prague.`;

const alternates = {
  cs: collectionPath(line.slug.cs, 'cs', entry?.slug, page.currentPage),
  en: collectionPath(line.slug.en, 'en', entry?.slug, page.currentPage),
};

const isCurrent = (item: MenuItem) => (item.slug === entry?.slug ? 'page' : undefined);
const emptyItems = line.menu.flatMap((g) => g.items).filter((i) => i.match.length === 0);
---

<Base title={title} description={description} alternates={alternates} label={lineName}>
  <div class="wrap">
    <nav class="menu" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
      {
        line.menu.map((group) => (
          <div class="group">
            <h2>
              <a href={withBase(collectionPath(line.slug[lang], lang, group.slug))} aria-current={isCurrent(group)}>
                {group.name}
              </a>
            </h2>
            {group.items.length > 0 && (
              <ul role="list">
                {group.items.map((item) => (
                  <li>
                    <a href={withBase(collectionPath(line.slug[lang], lang, item.slug))} aria-current={isCurrent(item)}>
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </nav>

    <ProductGrid products={page.data} lang={lang} />
    <Pagination current={page.currentPage} last={page.lastPage} pathFor={pathFor} lang={lang} />

    {
      emptyItems.length > 0 && (
        <Note title="Kategorie bez produktů">
          <p>
            Z návrhu, ale ve starém e-shopu pro ně nejsou žádné kusy: {emptyItems.map((i) => i.name).join(', ')}. Ostatní kategorie jsou namapované na starý e-shop v src/config/lines.ts, sporné jsou „Hrnek malý“ (dřív „Mini“) a „Miska velká“ (dřív „Polévka/Snídaně“).
          </p>
        </Note>
      )
    }
  </div>
</Base>

<style>
  .menu {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--gap);
    padding-block-end: var(--space-8);
  }

  .menu ul {
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .menu {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
