---
// "O nás" after docs/design/kosovi_o_nas.pdf (Sami, November 2026): the couple
// on an olive field with their photograph, the blue-and-white porcelain on
// white, then both biographies side by side on a blue and an orange field,
// each across the whole width. Section names in capitals, the text in
// Claristik at 24 px on 28 at 1512 (the PDF's sizes).
// The Czech text is Sami's (the PDF); the biographies are Daniela's and
// Martin's own from the old site. Only typing errors and punctuation are
// corrected. The English is a working translation (phase 6).
import { Image } from 'astro:assets';
import couplePhoto from '../assets/pages/o-nas/manzele-kosovi.jpg';
import Base from '../layouts/Base.astro';
import { alternatesOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { typeset } from '../lib/typography';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (text: string) => typeset(text, lang);

const copy = {
  cs: {
    title: 'O nás',
    description: 'Daniela a Martin Kosovi, výtvarníci a porcelánový ateliér v Praze 6. Modrobílý porcelán od roku 1995 a autorská tvorba obou.',
    couple: 'Manželé Kosovi',
    coupleText: [
      'Daniela a Martin Kosovi tvoří ve svém pražském ateliéru už desítky let. Jejich práce se pohybují v rozmezí jídelního porcelánu až po výtvarné objekty, které zkrášlují jak vnitřní, tak venkovní prostory. Lidé znají především jejich modrobílý porcelán, který zdobí nemálo domácností v Česku i ve světě. Je technicky precizní, a přesto každý kus originál.',
      'Martin je vyučený hrnčíř. Hrnčířskému kruhu je věrný od dětství a pracuje převážně s porcelánem. Daniela často čerpá ze své pohádkové představivosti. Její díla jsou doprovázena kresbou nebo barvou. Ve své tvorbě využívá mnoho odlišných technik. Modelování, texty nebo malba.',
    ],
    photoAlt: 'Martin a Daniela Kosovi se dívají dalekohledy, za nimi zděná stavba s velkými okny',
    blueWhite: 'Modrobílý porcelán',
    blueWhiteText: [
      'Výrobky z modrobílého porcelánu vynikají jak svým elegantním vzhledem, tak i vysokou technologickou hodnotou. Všechny produkty jsou točeny z technického porcelánu, který se původně používal na elektrické izolátory, jež jsou celoročně vystavované těžkým venkovním podmínkám.',
      'Tento materiál není nějak zdravotně závadný, ale práce s ním je náročnější než s klasickým porcelánem či keramikou. Samotná výroba má několik etap, které zaručují kvalitu konečného výrobku.',
      'Každý produkt je točen na hrnčířském kruhu a prochází dvěma výpaly. Po prvním výpalu v elektrické peci je výrobek ručně malován voskem a poté ponořen do kobaltu, který zaručuje jeho krásnou modrou barvu. Následně je střep ponořen do průhledné glazury, která zajistí nestíratelnost dekoru. Díky druhému, vysokému výpalu na 1 380 °C v plynové peci se všechny vrstvy slijí.',
      'Takto vznikne dokonale slitý střep vysoké odolnosti, který můžete použít například i jako zapékací mísu, vkládat ho do myčky nebo mikrovlnné trouby.',
    ],
    daniela: [
      'Narodila jsem se v Bratislavě. Od dětství mě bavilo kreslení a modelování. Ve svém rodném městě jsem také vystudovala keramiku na střední škole uměleckého průmyslu, a poté jsem pokračovala na pražské UMPRUM. Za zásadní ve svém uměleckém vzdělání považuji sochařskou a keramickou praxi v ateliéru Andreje Rudavského a praxi v porcelánových fabrikách v Dubí a Duchcově.',
      'Největší inspirací je pro mne porcelán, protože je ve svém oboru takový „Rolls-Royce“. Jedná se o materiál velmi něžný, citlivý a především krásný. Práce s ním je sice technologicky velice náročná, ale poskytuje řadu možností, jak v oblasti tvarování, tak i dekorování.',
      'Při dekorování používám různé technologie, jak podglazurové vypalované na 1 390 stupňů Celsia, vtavné vypalované na 1 250 stupňů, tak i naglazurové včetně zlacení (výpal na 800 stupňů). Tato tvorba je jednou z nejúžasnějších činností, které v životě mohu dělat. Jsem za to velmi vděčná.',
      'S mou prací se mimo jiné můžete setkat ve sbírkách Uměleckoprůmyslového muzea v Praze, Jihočeské Alšově galerii, ve Slovenském centru designu v Bratislavě, v muzeu Darney ve Francii, v Porvoo ve Finsku a v mnohých soukromých sbírkách u nás i v zahraničí.',
    ],
    martin: [
      'Narodil jsem se roku 1959 v Hradci Králové. Oba mí rodičové, povoláním keramici, mne vedli k lásce k tomuto povolání už jako dítě školou povinné. O prázdninách jsem docházel do hrnčířské dílny v Týništi nad Orlicí, kde jsem se později i vyučil hrnčířem. Následně jsem absolvoval SPŠK v Bechyni stejně jako mí rodičové, a dokonce i můj děda.',
      'Po maturitě jsem pracoval v Družstvu Umělecké Výroby Keramo Praha a od roku 1987 jsem začal tvořit samostatně. Mým cílem bylo vždy vyrábět co možná nejdokonaleji řemeslně vyrobené zboží, za které by mne pochválil můj děda i jiní staří mistři, které jsem poznal v učení i na různých hrnčířských soutěžích.',
      'Časem jsem se naučil točit na hrnčířském kruhu i z porcelánu a po poznání jeho velkých kvalit a předností, oproti klasické keramice, jsem se už ke keramice nevrátil. Již přes 25 let tak pracuji jenom s porcelánem. Poznal jsem, že porcelán je velmi náročný na zpracování, avšak výrobky z tohoto materiálu jsou velmi kvalitní, doslova hodny královské tabule.',
      'Zboží, které vyrábím, si lidé nekupují proto, že ho nutně potřebují k životu, ale hlavně proto, že se jim líbí a pravidelným užíváním poznali jeho kvalitu. Tato skutečnost mne těší a je mi motorem se stále zlepšovat a vyrábět stále kvalitnější a oku milejší zboží. Stále je co se učit a stále je prostor pro zdokonalení.',
    ],
  },
  en: {
    title: 'About',
    description: 'Daniela and Martin Kos, artists and a porcelain studio in Prague 6. Blue and white porcelain since 1995 and the artwork of both.',
    couple: 'Daniela and Martin Kos',
    coupleText: [
      'Daniela and Martin Kos have worked in their Prague studio for decades. Their work ranges from tableware to art objects for indoor and outdoor spaces alike. People know them above all for their blue and white porcelain, which is at home in many households in the Czech Republic and abroad. It is technically precise, and yet every piece is one of a kind.',
      'Martin is a trained potter. He has stayed with the potter’s wheel since childhood and works mostly in porcelain. Daniela often draws on her fairy-tale imagination. Her works come with drawing or colour. She uses many different techniques in her work: modelling, texts or painting.',
    ],
    photoAlt: 'Martin and Daniela Kos looking through binoculars, a brick building with large windows behind them',
    blueWhite: 'Blue and white porcelain',
    blueWhiteText: [
      'The blue and white porcelain stands out both for its look and for its technical quality. Every piece is thrown from technical porcelain, the material once used for electrical insulators, which stand outdoors in harsh conditions all year round.',
      'The material is in no way harmful to health, but it is harder to work than ordinary porcelain or pottery. Making it takes several stages, which secure the quality of the finished piece.',
      'Every piece is thrown on the potter’s wheel and fired twice. After the first firing in an electric kiln, it is painted by hand with wax and then dipped in cobalt, which gives it its blue colour. Then it is dipped in a clear glaze, which keeps the decoration from wearing off. In the second, high firing at 1,380 °C in a gas kiln, all the layers fuse.',
      'The result is a fully fused, highly durable body that you can use as an oven dish, for example, or put in the dishwasher or the microwave.',
    ],
    daniela: [
      'I was born in Bratislava. Since childhood I have loved drawing and modelling. In my home town I studied ceramics at the secondary school of applied arts, and then went on to UMPRUM in Prague. I consider the sculpture and ceramics training in Andrej Rudavský’s studio and the practice in the porcelain factories in Dubí and Duchcov essential to my artistic education.',
      'My greatest inspiration is porcelain, because in its field it is a kind of Rolls-Royce. It is a very delicate, sensitive and above all beautiful material. Working with it is technically very demanding, but it offers many possibilities in both shaping and decoration.',
      'I decorate with various techniques: underglaze, fired at 1,390 °C, in-glaze, fired at 1,250 °C, and overglaze including gilding (fired at 800 °C). This work is one of the most wonderful things I can do in life. I am very grateful for it.',
      'My work can be found in the collections of the Museum of Decorative Arts in Prague, the Aleš South Bohemian Gallery, the Slovak Design Centre in Bratislava, the museum in Darney in France, Porvoo in Finland, and in many private collections at home and abroad.',
    ],
    martin: [
      'I was born in 1959 in Hradec Králové. My parents, both ceramicists, led me to love the craft when I was still a schoolboy. In the holidays I went to a pottery workshop in Týniště nad Orlicí, where I later trained as a potter. Then I graduated from the ceramics school in Bechyně, like my parents and even my grandfather.',
      'After school I worked at the Keramo Praha arts and crafts cooperative, and in 1987 I began working on my own. My aim has always been to make craftwork as well as I possibly can, work that my grandfather and the other old masters I met in my training and at pottery competitions would praise.',
      'In time I learned to throw porcelain on the wheel too, and once I knew its great qualities and its advantages over pottery, I never went back. For more than 25 years I have worked only in porcelain. I have learned that porcelain is very demanding to work, but what is made from it is of high quality, truly fit for a royal table.',
      'People do not buy what I make because they need it to live, but mainly because they like it and have come to know its quality through everyday use. That pleases me and drives me to keep improving and to make ever better things that are a pleasure to look at. There is always more to learn and always room to improve.',
    ],
  },
}[lang];
---

<Base title={copy.title} description={copy.description} alternates={alternatesOf('about')} label={copy.title}>
  <section class="couple" aria-labelledby="manzele-kosovi">
    <div class="wrap columns">
      <div class="text">
        <h2 id="manzele-kosovi">{copy.couple}</h2>
        {copy.coupleText.map((p) => <p>{t(p)}</p>)}
      </div>
      <Image
        class="photo"
        src={couplePhoto}
        alt={copy.photoAlt}
        widths={[480, 800, 1200, 1600, 2000]}
        sizes="(min-width: 48rem) 44vw, 100vw"
        loading="eager"
      />
    </div>
  </section>

  <section class="blue-white" aria-labelledby="modrobily-porcelan">
    <div class="wrap columns">
      <div class="text">
        <h2 id="modrobily-porcelan">{copy.blueWhite}</h2>
        {copy.blueWhiteText.map((p) => <p>{t(p)}</p>)}
      </div>
    </div>
  </section>

  <div class="bios">
    <div class="wrap columns">
      <section class="text bio daniela" aria-labelledby="daniela-kosova">
        <h2 id="daniela-kosova">Daniela Kosová</h2>
        {copy.daniela.map((p) => <p>{t(p)}</p>)}
      </section>
      <section class="text bio martin" aria-labelledby="martin-kos">
        <h2 id="martin-kos">Martin Kos</h2>
        {copy.martin.map((p) => <p>{t(p)}</p>)}
      </section>
    </div>
  </div>
</Base>

<style>
  /* The PDF's sizes at 1512: section names 17 px, text 24 px on 28 tracked
     2 %, two columns 658 wide and 25 apart inside the page's margins. */
  .couple,
  .blue-white,
  .bios {
    --text: clamp(1.0625rem, 1.5875vw, 1.5rem);
    --line: 1.1667;
  }

  .columns {
    display: grid;
    gap: var(--space-6) clamp(1rem, 1.65vw, 1.6rem);
  }

  .text h2 {
    margin-block-end: calc(var(--text) * var(--line));
    font-size: calc(var(--step-0) * 17 / 14.4);
  }

  .text p {
    max-width: none;
    font-family: var(--font-serif);
    font-size: var(--text);
    font-weight: 400;
    line-height: var(--line);
    /* the PDF's text runs 2 % wider than the font's own spacing */
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .text p + p {
    margin-block-start: calc(var(--text) * var(--line));
  }

  /* The couple on an olive field, the photograph on the second column, its top
     on the section name's. */
  .couple {
    margin-block-start: clamp(0.5rem, 2vw, 2rem);
    padding-block: clamp(2rem, 3.2vw, 3rem) clamp(2.5rem, 4.9vw, 4.6rem);
    background: #d6cf93;
  }

  .photo {
    width: 100%;
    height: auto;
  }

  .blue-white {
    padding-block: clamp(2.75rem, 5.8vw, 5.5rem) clamp(3.5rem, 8.9vw, 8.4rem);
  }

  /* Both biographies across the whole width: Daniela's field from the left
     edge to the middle, Martin's from the middle to the right edge (the
     fields reach past the page's frame, the section clips them). */
  .bios {
    overflow-x: clip;
  }

  .bios .columns {
    row-gap: 0;
  }

  .bio {
    padding-block: clamp(2.5rem, 4.6vw, 4.4rem) clamp(2.5rem, 5vw, 4.75rem);
  }

  /* the names stand two lines above the biographies */
  .bio h2 {
    margin-block-end: calc(2 * var(--text) * var(--line));
  }

  .daniela {
    border-image: linear-gradient(#a6d3ff 0 0) fill 0 / / 0 100vw;
  }

  .martin {
    border-image: linear-gradient(#ff8a00 0 0) fill 0 / / 0 100vw;
  }

  @media (min-width: 48rem) {
    .columns {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .bios .columns {
      align-items: stretch;
    }

    /* the fields meet in the middle of the gap between the columns */
    .daniela {
      border-image-outset: 0 calc(clamp(1rem, 1.65vw, 1.6rem) / 2) 0 100vw;
    }

    .martin {
      border-image-outset: 0 100vw 0 calc(clamp(1rem, 1.65vw, 1.6rem) / 2);
      /* Martin's text 16 points in from the column, as wide as Daniela's (the
         PDF lets it run that much past the page's margin) */
      margin-inline-end: -1.06vw;
      padding-inline-start: 1.06vw;
    }
  }
</style>
