---
import { getImage, Image } from 'astro:assets';
import MakerCredit from '../components/MakerCredit.astro';
import Price from '../components/Price.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Note from '../components/wire/Note.astro';
import Placeholder from '../components/wire/Placeholder.astro';
import { getLine, placeOf } from '../config/lines';
import { studio } from '../config/site';
import Base from '../layouts/Base.astro';
import { collectionPath, productPath } from '../i18n/routes';
import { withBase } from '../i18n/utils';
import { getRelatedProducts, makersOf, type Product } from '../lib/products';
import { cz, formatNumber } from '../lib/typography';

// Product pages are Czech only for now (English comes later, see CLAUDE.md).
interface Props {
  product: Product;
}

const { product } = Astro.props;
const line = getLine(product.line);
const { group, item } = placeOf(line, product);
const crumbs = [group, item].filter((e) => e !== undefined);

// TODO: "related pieces from the same set" needs a set field in the data.
// Until then, show pieces from the same category, same size or shape first.
const related = await getRelatedProducts(product);

// Large version for the zoom link. Never link to the raw original.
const zoomed = await Promise.all(
  product.images.map((img) => getImage({ src: img.src, width: Math.min(2400, img.src.width) })),
);

const ask = (subject: string) => `mailto:${studio.email}?subject=${encodeURIComponent(`${subject}: ${product.title}`)}`;
const soldOut = product.stock === 0;

const { dimensions, care } = product;
const params: [string, string | undefined][] = [
  ['Výška', dimensions?.heightCm !== undefined ? cz(`${formatNumber(dimensions.heightCm)} cm`) : undefined],
  ['Průměr', dimensions?.diameterCm !== undefined ? cz(`${formatNumber(dimensions.diameterCm)} cm`) : undefined],
  ['Objem', dimensions?.volumeMl !== undefined ? cz(`${formatNumber(dimensions.volumeMl)} ml`) : undefined],
  ['Technika', product.technique],
  ['Myčka', care?.dishwasher === undefined ? undefined : care.dishwasher ? 'ano' : 'ne'],
  ['Mikrovlnná trouba', care?.microwave === undefined ? undefined : care.microwave ? 'ano' : 'ne'],
  ['Katalogové číslo', product.catalogNo],
];

// Old descriptions keep their line breaks: blank line = paragraph, newline = <br>.
const paragraphs = (product.description ?? '')
  .split(/\n{2,}/)
  .map((p) => p.split('\n').map((line) => cz(line.trim())))
  .filter((lines) => lines.some(Boolean));

const metaDescription = product.description
  ? product.description.replace(/\s+/g, ' ').slice(0, 155)
  : `${product.title}. ${line.name.cs}, porcelán z ateliéru Daniely a Martina Kosových v Praze.`;
---

<Base title={product.title} description={metaDescription} alternates={{ cs: productPath(product.slug) }} label={line.name.cs} labelIsHeading={false}>
  <div class="section wrap">
    <p class="crumbs">
      <a href={withBase(collectionPath(line.slug.cs, 'cs'))}>{line.name.cs}</a>
      {
        crumbs.map((entry) => (
          <>
            {' / '}
            <a href={withBase(collectionPath(line.slug.cs, 'cs', entry.slug))}>{entry.name}</a>
          </>
        ))
      }
    </p>

    <div class="product">
      <div class="gallery">
        {
          product.images.map((img, i) => (
            <a href={zoomed[i]?.src}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 60rem) 55vw, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </a>
          ))
        }
        {product.images.length === 0 && <Placeholder label="chybí fotografie" ratio="4 / 5" />}
        {
          product.images.length < 4 && (
            <Note>
              <p>
                Fotografie: {product.images.length} z 4–6. Chybí hlavně záběr v ruce pro měřítko a detail malby (nové focení).
              </p>
            </Note>
          )
        }
      </div>

      <div class="info stack">
        <h1>{product.title}</h1>
        <MakerCredit makers={makersOf(product)} lang="cs" />
        <Price price={product.price} lang="cs" />
        {soldOut && <p class="sold-out">Vyprodáno</p>}
        {
          product.options?.map((option, i) => (
            <label class="option">
              {option.name}
              <select name={`option-${i}`} disabled>
                {option.values.map((value) => (
                  <option>{value}</option>
                ))}
              </select>
            </label>
          ))
        }
        {
          product.price === null ? (
            <p>
              <a class="button button--quiet" href={ask('Dotaz na cenu')}>
                Zeptat se na cenu
              </a>
            </p>
          ) : soldOut ? (
            <p>
              <a class="button button--quiet" href={ask('Dotaz na dostupnost')}>
                Zeptat se na dostupnost
              </a>
            </p>
          ) : (
            <p>
              <button class="button" type="button" disabled>
                Vložit do košíku
              </button>
            </p>
          )
        }

        <dl class="params">
          {
            params.map(([label, value]) => (
              <div class={value === undefined ? 'missing' : undefined}>
                <dt>{label}</dt>
                <dd>{value ?? 'TODO(fakta)'}</dd>
              </div>
            ))
          }
        </dl>

        <p class="handmade">{cz('Každý kus je ručně vyrobený, a proto se od ostatních mírně liší.')}</p>

        {
          paragraphs.length > 0 && (
            <div class="description">
              {paragraphs.map((lines) => (
                <p>
                  {lines.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
              ))}
            </div>
          )
        }

        <Note title="Stránka produktu">
          <ul>
            <li>Kdo kus vyrobil, cena nebo „cena na dotaz“, rozměry a objem, technika, péče, poznámka o ruční výrobě.</li>
            <li>4–6 velkých fotografií včetně záběru pro měřítko a detailu malby. Proklik na plnou velikost, lightbox ve fázi 4. Pinch zoom zůstává povolený.</li>
            <li>Košík, volba varianty a dotaz na cenu přijdou ve fázi 5.</li>
            <li>Popis je převzatý ze starého webu beze změny. Rozměry v tabulce jsou z něj vytažené tam, kde řádek uvádí jednu hodnotu.</li>
          </ul>
        </Note>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section wrap">
        <h2 class="section-head">Ze stejné sady</h2>
        <ProductGrid products={related} lang="cs" />
        <Note>
          <p>Data zatím neříkají, které kusy patří do jedné sady. Do té doby se zobrazují kusy ze stejné kategorie, nejdřív stejné velikosti.</p>
        </Note>
      </section>
    )
  }
</Base>

<style>
  .crumbs {
    margin-block-end: var(--space-5);
  }

  .product {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .product {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }

    .info {
      position: sticky;
      top: var(--space-5);
    }
  }

  .gallery {
    display: grid;
    gap: var(--space-4);
  }

  .gallery :global(img) {
    width: 100%;
  }

  .params {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-line);
  }

  .params > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  dt {
    color: var(--color-muted);
  }

  dd {
    margin: 0;
    text-align: end;
  }

  .missing dd {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-muted);
  }

  /* Unknown values show only in the preview, the live page hides them. */
  :global(html:not([data-notes='on'])) .missing {
    display: none;
  }

  .sold-out {
    font-weight: var(--weight);
  }

  .option {
    display: grid;
    gap: var(--space-1);
  }

  .option select {
    padding: var(--space-2);
    border: 1px solid var(--color-muted);
    border-radius: var(--radius);
  }

  .description > * + * {
    margin-block-start: var(--space-3);
  }

  .handmade {
    font-size: var(--step--1);
  }
</style>
