---
// Product page after kosovi_detail_produktu.pdf (Sami, November 2026): the
// e-shop's tabs, then the photo and beside it the name, the price, the
// quantity and the button for the cart, and at the photo's foot a short text,
// the sizes with the catalogue number, the material, a rule and the note on
// sizes. The kinds of the open tab sit on an ochre panel at the left that
// stays hidden and slides out when the pointer comes over its place (Sami,
// November 2026). Under them, on a pale green band across the whole width, related
// pieces: the same kind with a similar decor, the same decor on other kinds,
// and in Ostatní the tab's other pieces. No maker credit on this page.
import { getImage, Image } from 'astro:assets';
import RelatedBand from '../components/RelatedBand.astro';
import ShopTabs from '../components/ShopTabs.astro';
import { kindTexts } from '../config/descriptions';
import { getLine, listEntries, placeOf } from '../config/lines';
import { studio } from '../config/site';
import Base from '../layouts/Base.astro';
import { collectionPath, pathOf, productPath } from '../i18n/routes';
import { withBase } from '../i18n/utils';
import { photoFit } from '../lib/edges';
import { askOnly as isAskOnly, getSameDecor, getSameSet, getSameTab, showsPrice, type Product } from '../lib/products';
import { productLabel } from '../lib/names';
import { cz, formatCzk, formatNumber } from '../lib/typography';

// Product pages are Czech only for now (English comes later, see CLAUDE.md).
interface Props {
  product: Product;
}

const { product } = Astro.props;
// Shown without "Porcelánový" (design eshop.pdf); the data keeps the old title.
const name = productLabel(product.title);
const line = getLine(product.line);
const { group, item } = placeOf(line, product);
const kindsHref = (slug: string) => withBase(collectionPath(line.slug.cs, 'cs', slug));
// The panel that slides out from the side: the open tab's kinds, or, in a
// line whose tabs have no kinds (Martin's), the line's categories, the
// product's own underlined (Sami, November 2026).
const drawer = group && group.items.length > 0
  ? listEntries(group).map((e) => ({ name: e.name, slug: e.slug, current: !!item && e.kinds.includes(item.slug) }))
  : line.tabs
    ? line.menu.map((g) => ({ name: g.name, slug: g.slug, current: g === group }))
    : [];
const drawerLabel = group && group.items.length > 0 ? group.name : line.name.cs;
// Below 60rem the blue-and-white tab's kinds stand in the ochre band at the
// top instead (ShopTabs); makers' pieces have no kinds, and phones put their
// name over the tabs (Sami, November 2026).
const blueWhite = product.line === 'spolecna';
const bandKinds =
  blueWhite && group && group.items.length > 0
    ? drawer.map((e) => ({ name: e.name, href: kindsHref(e.slug), current: e.current }))
    : [];
const bandName = blueWhite
  ? { text: line.name.cs, href: withBase(collectionPath(line.slug.cs, 'cs')) }
  : { text: line.name.cs, href: withBase(pathOf(product.line as 'martin' | 'daniela', 'cs')) };

// Large version for the zoom link. Never link to the raw original.
const zoomed = await Promise.all(
  product.images.map((img) => getImage({ src: img.src, width: Math.min(2400, img.src.width) })),
);
// Photos that do not fit the PDF's box (666 × 501) get its empty sides painted
// in their own edge colours (src/lib/edges.ts).
const fits = await Promise.all(product.images.map((img) => photoFit(img.src, 666 / 501)));

const ask = (subject: string) => `mailto:${studio.email}?subject=${encodeURIComponent(`${subject}: ${product.title}`)}`;
// Martin's pieces, the stamped mugs aside, and Daniela's are not sold
// through the cart: the button asks about the piece by e-mail, with a link to
// its page, since several share a name (Sami, November 2026).
const askOnly = isAskOnly(product);
const askAbout = `mailto:${studio.email}?subject=${encodeURIComponent(`Dotaz: ${product.title}`)}&body=${encodeURIComponent(`${product.title}\n${new URL(withBase(productPath(product.slug)), Astro.site ?? Astro.url).href}\n\n`)}`;
const soldOut = product.stock === 0;
const onRequest = product.price === null;
// Made to order, so the page says so and the button orders by e-mail (Sami,
// November 2026): the dinner set. Keyed by the old shop's subcategory.
const madeToOrder: Record<string, string> = {
  'jidelni-soupravy': 'Jídelní soupravy jsou na objednávku',
};
const toOrder = product.subcategory ? madeToOrder[product.subcategory] : undefined;
const maxQty = product.stock && product.stock > 0 ? Math.min(product.stock, 10) : 10;

// The kind's short text (src/config/descriptions.ts), else the old description.
const texts = kindTexts[product.line] ?? {};
const kindText = (item && texts[item.slug]) ?? (group && texts[group.slug]);
// The kind's text breaks after its first sentence (Sami, November 2026), or
// where it has a line break of its own (the stamped mugs', Sami).
const firstStop = kindText ? kindText.indexOf('. ') : -1;
const paragraphs = kindText
  ? [
      kindText.includes('\n')
        ? kindText.split('\n').map((l) => cz(l.trim()))
        : firstStop > 0
          ? [cz(kindText.slice(0, firstStop + 1)), cz(kindText.slice(firstStop + 2))]
          : [cz(kindText)],
    ]
  : (product.description ?? '')
      .split(/\n{2,}/)
      .map((p) => p.split('\n').map((l) => cz(l.trim())))
      .filter((lines) => lines.some(Boolean));

// The blue-and-white pieces' sizes rounded to whole centimetres, as in the
// size chart (Sami, November 2026); Martin's as the old site gives them
// (7,5 cm, Sami, November 2026). "Průměr" where the PDF has "Šířka" (Sami,
// November 2026).
const { dimensions } = product;
const cm = (value: number) => `${product.line === 'spolecna' ? Math.round(value) : formatNumber(value)} cm`;
const height = item?.size ?? (dimensions?.heightCm !== undefined ? cm(dimensions.heightCm) : undefined);
const sizes: [string, string | undefined][] = [
  ['Výška', height && cz(height)],
  ['Průměr', dimensions?.diameterCm !== undefined ? cz(cm(dimensions.diameterCm)) : undefined],
  ['Objem', dimensions?.volumeMl !== undefined ? cz(`${formatNumber(dimensions.volumeMl)} ml`) : undefined],
];
// Where the data lists the old site's sizes (Daniela's pieces), those, as they
// are (Sami, November 2026).
const shownSizes = product.sizes?.length
  ? product.sizes.map((s): [string, string] => [s.label, cz(s.value)])
  : sizes.filter((f): f is [string, string] => f[1] !== undefined);
const facts: [string, string][] = [...shownSizes, ...(product.catalogNo ? [['Katalogové číslo', product.catalogNo] as [string, string]] : [])];
// No "100% porcelán" (Sami, November 2026: it was on every piece but the
// teapots and tea sets with rattan handles).
const [firstPhoto, ...morePhotos] = product.images.map((img, i) => ({ img, i }));

// Five tiles a page (Sami, November 2026): "Ze stejné sady" is the same kind
// with a similar decor (a motif in common: "s andělem na kole" goes with
// bicycles and angels); "Se stejným dekorem" the same decor on other kinds,
// at least two when there are; the tab's other pieces fill the rest under
// "Další". Up to three pages, each built the same way, to page through with
// the band's arrows (Sami, November 2026). Martin's and Daniela's pieces show
// them all under "Další" alone.
const TILES = 5;
const PAGES = 3;
const sameSet = await getSameSet(product);
const sameDecor = await getSameDecor(product);
const related = new Set([...sameSet, ...sameDecor].map((p) => p.slug));
const setPool = [...sameSet];
const decorPool = [...sameDecor];
const tabPool = (await getSameTab(product)).filter((p) => !related.has(p.slug));
const pages: { set: Product[]; decor: Product[]; tab: Product[] }[] = [];
for (let i = 0; i < PAGES && (setPool.length || decorPool.length || tabPool.length); i++) {
  const decor = decorPool.splice(0, Math.min(TILES, Math.max(2, TILES - setPool.length)));
  const set = setPool.splice(0, TILES - decor.length);
  const tab = tabPool.splice(0, TILES - set.length - decor.length);
  pages.push({ set, decor, tab });
}
const groups =
  product.line === 'spolecna'
    ? pages.flatMap(({ set, decor, tab }) => [
        { title: 'Ze stejné sady', products: set },
        { title: 'Se stejným dekorem', products: decor },
        { title: 'Další', products: tab },
      ])
    : [{ title: 'Další', products: pages.flatMap(({ set, tab, decor }) => [...set, ...tab, ...decor]) }];

const metaDescription = kindText
  ? `${name}. ${kindText.replace(/\s+/g, ' ')}`
  : product.description
    ? product.description.replace(/\s+/g, ' ').slice(0, 155)
    : `${product.title}. ${line.name.cs}, porcelán z ateliéru Daniely a Martina Kosových v Praze.`;
---

<Base
  title={name}
  description={metaDescription}
  alternates={{ cs: productPath(product.slug) }}
  section={product.line === 'spolecna' ? 'blueWhite' : product.line}
>
  <div class="wrap">
    <div class:list={['tabs-row', blueWhite ? 'band-narrow' : 'band-phone']}>
      <ShopTabs line={line} lang="cs" group={group} name={bandName} kinds={bandKinds} bandBelow={blueWhite ? 'narrow' : 'phone'} />
    </div>

    <div class="product">
      {
        drawer.length > 0 && (
          <nav class:list={['drawer', { repeats: !(group && group.items.length > 0) }]} aria-label={drawerLabel}>
            <div class="panel">
              <ul role="list">
                {drawer.map((e) => (
                  <li>
                    <a href={kindsHref(e.slug)} aria-current={e.current ? 'true' : undefined}>
                      {e.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }

      {
        firstPhoto && (
          <a
            class="photo first"
            href={zoomed[firstPhoto.i]?.src}
            data-sides={fits[firstPhoto.i]?.sides}
            style={fits[firstPhoto.i]?.style || undefined}
          >
            <Image
              src={firstPhoto.img.src}
              alt={firstPhoto.img.alt}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 60rem) 45vw, 100vw"
              loading="eager"
            />
          </a>
        )
      }

      <div class="info">
        <div class="top">
          <h1>{name}</h1>
          {showsPrice(product) && <p class="price">{toOrder ? cz(toOrder) : onRequest ? 'Cena na dotaz' : formatCzk(product.price!)}</p>}

          <form class="buy" data-cart-form data-slug={product.slug}>
            {
              product.options?.map((option, i) => (
                <label class="box option">
                  <span class="visually-hidden">{option.name}</span>
                  <select name={`option-${i}`} data-option={option.name}>
                    {option.values.map((value) => (
                      <option>{value}</option>
                    ))}
                  </select>
                </label>
              ))
            }
            {
              askOnly ? (
                <a class="box wide" href={askAbout}>
                  Zeptat se na produkt
                </a>
              ) : onRequest || soldOut ? (
                <a class="box wide" href={ask(toOrder ? 'Objednávka' : onRequest ? 'Dotaz na cenu' : 'Dotaz na dostupnost')}>
                  {toOrder ? 'Chci objednat' : onRequest ? 'Zeptat se na cenu' : 'Zeptat se na dostupnost'}
                </a>
              ) : (
                <>
                  <label class="box qty">
                    <span class="visually-hidden">Počet kusů</span>
                    <select name="qty">
                      {Array.from({ length: maxQty }, (_, i) => (
                        <option value={i + 1}>{i + 1} ks</option>
                      ))}
                    </select>
                  </label>
                  <button class="box add" type="submit">
                    Vložit do košíku
                  </button>
                </>
              )
            }
            <p class="added" role="status" aria-live="polite" data-added hidden>
              {cz('Přidáno do košíku.')} <a href={withBase('/kosik/')}>Otevřít košík</a>
            </p>
          </form>
        </div>

        <div class="bottom">
          <div class="text">
            {
              paragraphs.map((lines) => (
                <p>
                  {lines.map((l, i) => (
                    <>
                      {i > 0 && <br />}
                      {l}
                    </>
                  ))}
                </p>
              ))
            }
            {soldOut && <p>{cz('Tento kus je vyprodaný.')}</p>}
          </div>

          {
            facts.length > 0 && (
              <dl class="facts">
                {facts.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {
            /* not on Daniela's pieces (Sami, November 2026) */
            shownSizes.length > 0 && product.line !== 'daniela' && (
              <>
                <hr />
                <p class="note">{cz('Míry jsou orientační, každý kus je originální, a proto se jejich velikosti můžou lišit.')}</p>
              </>
            )
          }
        </div>
      </div>

      {
        morePhotos.length > 0 && (
          <div class="photos">
            {morePhotos.map(({ img, i }) => (
              <a class="photo" href={zoomed[i]?.src} data-sides={fits[i]?.sides} style={fits[i]?.style || undefined}>
                <Image src={img.src} alt={img.alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 60rem) 45vw, 100vw" />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <RelatedBand groups={groups} label="Další kusy" lang="cs" />
</Base>

<script>
  // The cart lives in localStorage until the order flow (phase 5):
  // [{ slug, qty, options }], the header's badge shows the sum of pieces.
  type Line = { slug: string; qty: number; options?: Record<string, string> };
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-cart-form]')) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const slug = form.dataset.slug!;
      const qty = Number((form.elements.namedItem('qty') as HTMLSelectElement | null)?.value ?? 1);
      const options: Record<string, string> = {};
      form.querySelectorAll<HTMLSelectElement>('select[data-option]').forEach((s) => {
        options[s.dataset.option!] = s.value;
      });
      let cart: Line[] = [];
      try {
        const stored: unknown = JSON.parse(localStorage.getItem('kosovi-cart') ?? '[]');
        if (Array.isArray(stored)) cart = stored as Line[];
      } catch {}
      const same = cart.find((l) => l.slug === slug && JSON.stringify(l.options ?? {}) === JSON.stringify(options));
      if (same) same.qty = (same.qty ?? 1) + qty;
      else cart.push({ slug, qty, options });
      try {
        localStorage.setItem('kosovi-cart', JSON.stringify(cart));
      } catch {}
      document.dispatchEvent(new CustomEvent('kosovi-cart'));
      const added = form.querySelector<HTMLElement>('[data-added]');
      if (added) added.hidden = false;
    });
  }
</script>

<style>
  /* the tabs as far under the header as in the ochre band (Sami, November 2026) */
  .tabs-row {
    padding-block: var(--tabs-top) clamp(2.5rem, 7.5vw, 7.5rem);
  }

  .product {
    display: grid;
    gap: var(--space-5);
  }

  /* The kinds of the open tab on an ochre panel, white, the product's kind
     underlined. */
  .panel {
    background: var(--color-ochre);
    color: #fff;
  }

  .panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel a {
    color: inherit;
    text-decoration: none;
  }

  .panel a:hover,
  .panel [aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* Below 60rem (tablets and phones) no panel: the blue-and-white tab's
     kinds stand in the ochre band at the top (ShopTabs), the makers' pieces
     have only their tabs; the photos come first and the product's name, price,
     text and sizes after the last of them (Sami, November 2026). */
  @media (max-width: 59.99rem) {
    .drawer {
      display: none;
    }

    .info {
      order: 1;
    }

    .band-narrow {
      padding-block: 0 2rem;
    }
  }

  @media (max-width: 47.99rem) {
    .band-phone {
      padding-block: 0 2rem;
    }
  }

  .photos {
    display: grid;
    gap: var(--space-3);
  }

  /* The whole photo in the PDF's box (666 × 501). Where it leaves the box's
     sides empty, they carry the photo's own edge colours (set inline, see
     src/lib/edges.ts) and the photo's edges fade into them. */
  .photo {
    position: relative;
    display: block;
    aspect-ratio: 666 / 501;
    overflow: hidden;
    background: var(--color-tile);
  }

  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: var(--pw, 100%);
    height: var(--ph, 100%);
    margin: auto;
    object-fit: contain;
  }

  .photo[data-sides='x'] :global(img) {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .photo[data-sides='y'] :global(img) {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
  }

  /* Name, price and the cart at the top; text, sizes, material and the note at
     the photo's foot. */
  .info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
  }

  h1 {
    font-size: inherit;
  }

  .price {
    margin-block-start: 1.0625rem;
    white-space: nowrap;
  }

  /* Text in small letters: Claristik clarendon, 14 px at 1512 as in the PDF. */
  .text,
  .note,
  .added {
    font-family: var(--font-serif);
    font-size: clamp(0.8125rem, 0.6rem + 0.29vw, 0.875rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.36;
    text-transform: none;
    color: #333;
  }

  .buy {
    display: grid;
    grid-template-columns: 31.6% 1fr;
    gap: var(--space-2) 2.5%;
    margin-block-start: 1.6rem;
  }

  .box {
    display: grid;
    place-items: center;
    min-height: 1.75rem;
    padding-inline: var(--space-2);
    border: 0;
    border-radius: 0;
    background: var(--color-ochre);
    color: var(--color-ink);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  /* "1 ks" centred in its box without the browser's arrow, as in the PDF */
  .box select {
    width: 100%;
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: center;
    text-align-last: center;
    cursor: pointer;
  }

  .option,
  .wide,
  .added {
    grid-column: 1 / -1;
  }

  .add:hover,
  .wide:hover,
  .box:has(select:hover) {
    background: color-mix(in srgb, var(--color-ochre) 55%, var(--color-select));
    color: #fff;
  }

  .facts {
    display: grid;
    margin: 3rem 0 0;
    padding: 0;
    line-height: 1.18;
  }

  .text:empty + .facts {
    margin-block-start: 0;
  }

  .facts > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  dt,
  dd {
    margin: 0;
  }

  dd {
    text-align: end;
  }


  hr {
    margin-block: 2.1rem 2rem;
    border: 0;
    border-top: 1px solid var(--color-ink);
  }

  /* From the PDF at 1512: the panel from the screen's edge to 10 points short
     of the photo, the photo two and a half listing columns wide, the rest from
     70.5 % across. */
  @media (min-width: 60rem) {
    .product {
      --bleed: max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
      container-type: inline-size;
      grid-template-columns: 20.15% 49.6% 0.75% 1fr;
      gap: var(--space-3) 0;
      align-items: start;
    }

    .photo.first {
      grid-column: 2;
      grid-row: 1;
    }

    .photos {
      grid-column: 2;
      grid-row: 2;
    }

    .info {
      grid-column: 4;
      grid-row: 1;
      align-self: stretch;
      padding-inline-start: 0.66vw;
    }

    hr {
      margin-inline-start: -0.66vw;
    }

    /* Hidden until the pointer comes over its place (or a link in it takes
       the focus), then it slides out from the side (Sami, November 2026). */
    /* as tall as the photo beside it, whatever the text column needs */
    .drawer {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      height: calc(49.6cqi * 501 / 666);
      position: relative;
      overflow: hidden;
      margin-inline: calc(-1 * var(--bleed)) 0.66vw;
    }

    .panel {
      position: absolute;
      inset: 0;
      padding: 4.75vw 0 0 calc(var(--bleed) - var(--gutter) + 2.8vw);
      transform: translateX(-100%);
      transition: transform 0.35s ease;
    }

    .drawer:hover .panel,
    .drawer:focus-within .panel {
      transform: none;
    }

    .panel ul {
      flex-direction: column;
      gap: 0.3rem;
    }
  }

  /* Without a pointer that can hover, the panel stays out. */
  @media (min-width: 60rem) and (hover: none) {
    .panel {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition: none;
    }
  }
</style>
