---
// Header after the second kosovi_homepage.pdf (Sami, November 2026): the brand
// on the left, opening the homepage; the menu on the right, all of it in
// capitals at the size of the rest of the site (the PDF's 16 px was too large,
// Sami, November 2026): Modrobílý porcelán (the e-shop's first listing),
// Daniela and Martin (their pages), O nás, Kurzy, Kontakt, the cart while
// something is in it, and the language switch ("EN", on English pages "CZ").
// The item a page belongs under is underlined. White on every page, without a
// rule under it. On the homepage it stays in view while the page scrolls, only
// its black text, with no white behind it (Sami, November 2026). On phones
// every other page folds the menu behind a three-line button (Sami, November
// 2026).
import { getLine } from '../config/lines';
import { studio } from '../config/site';
import { collectionPath, pathOf, type Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { cz } from '../lib/typography';

/** The header's item a page belongs under. */
export type Section = 'blueWhite' | 'daniela' | 'martin';

interface Props {
  lang: Lang;
  /** Paths of this page in each language, for the language switch. */
  alternates?: Alternates;
  /** Where the page's path does not tell (a product page). */
  section?: Section;
  /** Stays in view while the page scrolls, its text alone over the photographs (the homepage). */
  sticky?: boolean;
  /** On phones the menu folds behind a three-line button (every page but the homepage). */
  collapsible?: boolean;
}

const { lang, alternates = {}, section, sticky = false, collapsible = false } = Astro.props;
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const switchPath = alternates[otherLang] ?? pathOf('home', otherLang);
const t = useTranslations(lang);
const lineOf = (key: 'spolecna' | 'daniela' | 'martin') => collectionPath(getLine(key).slug[lang], lang);

const current = Astro.url.pathname;
const under = (...paths: string[]) => paths.some((p) => current.startsWith(withBase(p)));
const cartPath = pathOf('cart', 'cs');
// each maker's item covers their page and their part of the e-shop
const here: Section | undefined =
  section ??
  (under(pathOf('daniela', lang), lineOf('daniela'))
    ? 'daniela'
    : under(pathOf('martin', lang), lineOf('martin'))
      ? 'martin'
      : under(pathOf('collections', lang), '/produkt/')
        ? 'blueWhite'
        : undefined);

const items = [
  { href: lineOf('spolecna'), label: t('nav.blueWhite'), current: here === 'blueWhite' },
  { href: pathOf('daniela', lang), label: t('nav.daniela'), current: here === 'daniela' },
  { href: pathOf('martin', lang), label: t('nav.martin'), current: here === 'martin' },
  { href: pathOf('about', lang), label: t('nav.about') },
  ...(lang === 'cs' ? [{ href: pathOf('courses', 'cs'), label: t('nav.courses') }] : []),
  { href: pathOf('contact', lang), label: t('nav.contact') },
].map((item) => ({ ...item, current: item.current || current === withBase(item.href) }));
---

<header class:list={['site-header', { sticky }]} data-collapsible={collapsible ? '' : undefined}>
  <div class="wrap bar">
    <a class="brand" href={withBase(pathOf('home', lang))}>{cz(studio.brand)}</a>
    {
      collapsible && (
        <button class="menu-button" type="button" aria-controls="site-menu" aria-expanded="false" data-menu-button>
          <span class="visually-hidden">Menu</span>
          <span class="lines" aria-hidden="true">
            <span />
            <span />
            <span />
          </span>
        </button>
      )
    }
    <nav id="site-menu" aria-label={t('nav.label')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li data-cart-item hidden>
          <a href={withBase(cartPath)} aria-current={current === withBase(cartPath) ? 'page' : undefined}>
            {t('nav.cart')}
            <span class="badge" data-cart-count hidden></span>
          </a>
        </li>
        <li>
          <a href={withBase(switchPath)} hreflang={otherLang} lang={otherLang} aria-label={t('lang.switch')}>
            {otherLang === 'en' ? 'EN' : 'CZ'}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // The cart lives in localStorage ([{ slug, qty }], phase 5); the badge shows
  // how many pieces, and updates when a product page adds some.
  function showCount() {
    let count = 0;
    try {
      const items: unknown = JSON.parse(localStorage.getItem('kosovi-cart') ?? '[]');
      if (Array.isArray(items)) {
        count = items.reduce((sum: number, l: { qty?: unknown }) => sum + (typeof l?.qty === 'number' ? l.qty : 1), 0);
      }
    } catch {}
    for (const badge of document.querySelectorAll<HTMLElement>('[data-cart-count]')) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
    // the cart shows in the menu only while something is in it
    for (const item of document.querySelectorAll<HTMLElement>('[data-cart-item]')) {
      item.hidden = count === 0;
    }
  }
  showCount();
  document.addEventListener('kosovi-cart', showCount);

  // On phones the menu of every page but the homepage folds behind the button;
  // without the script it stays open.
  for (const header of document.querySelectorAll<HTMLElement>('.site-header[data-collapsible]')) {
    const button = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    if (!button) continue;
    header.classList.add('folds');
    const set = (open: boolean) => {
      header.classList.toggle('open', open);
      button.setAttribute('aria-expanded', String(open));
    };
    button.addEventListener('click', () => set(!header.classList.contains('open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('open')) {
        set(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--gap);
    padding-block: clamp(1.75rem, 3.8vw, 3.6rem) clamp(0.9rem, 1.9vw, 1.8rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    /* about 59 points between the items at 1512, as in the PDF */
    gap: var(--space-2) clamp(1rem, 3.9vw, 3.7rem);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
  }

  /* On tablets and phones at the footer's size (Sami, November 2026). */
  @media (max-width: 63.99rem) {
    .site-header {
      font-size: var(--step-footer);
    }
  }

  .menu-button {
    display: none;
  }

  /* On phones at the size of a product's name; the menu items one under
     another, at the left under the studio's name, spaced like the footer's
     lines; on every page but the homepage folded behind a three-line button
     at the right (Sami, November 2026). */
  @media (max-width: 47.99rem) {
    .site-header {
      font-size: var(--step-0);
    }

    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      line-height: var(--leading-body);
    }

    /* close under the word, clear of the next line */
    [aria-current='page'] {
      text-underline-offset: 0.12em;
    }

    .folds .bar {
      flex-flow: row wrap;
      justify-content: space-between;
      align-items: center;
      row-gap: var(--space-5);
    }

    .folds nav {
      display: none;
      flex-basis: 100%;
    }

    .folds.open nav {
      display: block;
    }

    .folds .menu-button {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin: -0.75rem -0.6rem -0.75rem 0;
      padding: 0;
      border: 0;
      background: none;
      color: var(--color-ink);
      cursor: pointer;
    }

    .lines {
      position: relative;
      display: block;
      width: 1.375rem;
      height: 0.875rem;
    }

    .lines > span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .lines > span:nth-child(1) {
      top: 0;
    }

    .lines > span:nth-child(2) {
      top: calc(50% - 1px);
    }

    .lines > span:nth-child(3) {
      bottom: 0;
    }

    /* open, the lines cross */
    .open .lines > span:nth-child(1) {
      transform: translateY(calc(0.4375rem - 1px)) rotate(45deg);
    }

    .open .lines > span:nth-child(2) {
      opacity: 0;
    }

    .open .lines > span:nth-child(3) {
      transform: translateY(calc(-0.4375rem + 1px)) rotate(-45deg);
    }
  }

  @media (max-width: 47.99rem) and (prefers-reduced-motion: reduce) {
    .lines > span {
      transition: none;
    }
  }

  /* As tall as the capitals beside it, from their top to the baseline: an
     inline-block that hides its overflow sits with its bottom edge on the
     baseline in every browser. Moment's capitals are 0.67 em tall; the number
     inside is 0.6 em, so the box is 0.67 / 0.6 of its own em. */
  .badge {
    display: inline-block;
    overflow: hidden;
    vertical-align: baseline;
    min-width: calc(0.67em / 0.6);
    height: calc(0.67em / 0.6);
    margin-inline-start: 0.45em;
    padding-inline: 0.25em;
    border-radius: 0.2em;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.6em;
    line-height: calc(0.67em / 0.6);
    letter-spacing: 0;
    text-align: center;
  }

  /* Where the browser can trim the line to the figure's own height (from the
     top of the capitals to the baseline), centre the figure by padding alone,
     so it does not depend on how a browser rounds the font's line metrics. */
  @supports (text-box: trim-both cap alphabetic) {
    .badge {
      padding-block: calc((0.67em / 0.6 - 0.67em) / 2);
      line-height: 1;
      text-box: trim-both cap alphabetic;
    }
  }

  .badge[hidden],
  li[hidden] {
    display: none;
  }

  /* The text alone stays at the top while the page scrolls, in black like
     everywhere else, on computers, tablets and phones alike (Sami, November
     2026). The empty parts of the header let clicks through. */
  .sticky {
    position: sticky;
    top: 0;
    z-index: 10;
    pointer-events: none;
  }

  .sticky a {
    pointer-events: auto;
  }
</style>
