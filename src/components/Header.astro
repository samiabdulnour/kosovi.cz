---
import { studio } from '../config/site';
import { pathOf, type Alternates, type RouteKey } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { cz } from '../lib/typography';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const switchPath = alternates[otherLang] ?? pathOf('home', otherLang);

const items: { key: RouteKey; label: string }[] = [
  { key: 'collections', label: t('nav.collections') },
  { key: 'martin', label: t('nav.martin') },
  { key: 'daniela', label: t('nav.daniela') },
  { key: 'process', label: t('nav.process') },
  { key: 'about', label: t('nav.about') },
  ...(lang === 'cs' ? [{ key: 'courses' as const, label: t('nav.courses') }] : []),
  { key: 'contact', label: t('nav.contact') },
];

const current = Astro.url.pathname;
function isCurrent(path: string): 'page' | 'true' | undefined {
  const href = withBase(path);
  if (current === href) return 'page';
  return current.startsWith(href) ? 'true' : undefined;
}
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase(pathOf('home', lang))}>{cz(studio.name)}</a>
    <nav aria-label={t('nav.label')}>
      <ul class="nav">
        {
          items.map(({ key, label }) => {
            const path = pathOf(key, lang);
            return (
              <li>
                <a href={withBase(path)} aria-current={isCurrent(path)}>
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <ul class="tools">
      {
        lang === 'cs' && (
          <li>
            <a href={withBase(pathOf('cart', 'cs'))} aria-current={isCurrent(pathOf('cart', 'cs'))}>
              {t('nav.cart')}
            </a>
          </li>
        )
      }
      <li>
        <a href={withBase(switchPath)} hreflang={otherLang} lang={otherLang}>{t('lang.switch')}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-4);
  }

  .brand {
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    flex: 1 1 auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover,
  [aria-current] {
    text-decoration: underline;
  }

  [aria-current='page'] {
    text-decoration-thickness: 2px;
  }
</style>
