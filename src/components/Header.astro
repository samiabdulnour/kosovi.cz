---
// Header after eshop.pdf: brand on the left, the studio's name on the label
// line, the menu with the cart on the right. In the e-shop it turns light blue,
// without a rule under it.
import { getLine } from '../config/lines';
import { studio } from '../config/site';
import { collectionPath, pathOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { cz } from '../lib/typography';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const blueWhite = getLine('spolecna');

const current = Astro.url.pathname;
const inShop = [pathOf('collections', lang), '/produkt/', pathOf('cart', 'cs')].some((p) =>
  current.startsWith(withBase(p)),
);
const cartPath = pathOf('cart', 'cs');

const items = [
  // E-shop opens the first tab of the blue-and-white line, as in kosovi_eshop_2.pdf.
  { href: collectionPath(blueWhite.slug[lang], lang, blueWhite.menu[0]?.slug), label: t('nav.shop'), current: inShop && !current.startsWith(withBase(cartPath)) },
  { href: pathOf('about', lang), label: t('nav.about') },
  ...(lang === 'cs' ? [{ href: pathOf('courses', 'cs'), label: t('nav.courses') }] : []),
  { href: pathOf('contact', lang), label: t('nav.contact') },
].map((item) => ({ ...item, current: item.current || current === withBase(item.href) }));
---

<header class:list={['site-header', { shop: inShop }]}>
  <div class="wrap bar">
    <a class="brand" href={withBase(pathOf('home', lang))}>{cz(studio.brand)}</a>
    <p class="name">{cz(studio.name)}</p>
    <nav aria-label={t('nav.label')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase(cartPath)} aria-current={current === withBase(cartPath) ? 'page' : undefined}>
            {t('nav.cart')}
            <span class="badge" data-cart-count hidden></span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // The cart lives in localStorage ([{ slug, qty }], phase 5); the badge shows
  // how many pieces, and updates when a product page adds some.
  function showCount() {
    let count = 0;
    try {
      const items: unknown = JSON.parse(localStorage.getItem('kosovi-cart') ?? '[]');
      if (Array.isArray(items)) {
        count = items.reduce((sum: number, l: { qty?: unknown }) => sum + (typeof l?.qty === 'number' ? l.qty : 1), 0);
      }
    } catch {}
    for (const badge of document.querySelectorAll<HTMLElement>('[data-cart-count]')) {
      badge.textContent = String(count);
      badge.hidden = count === 0;
    }
  }
  showCount();
  document.addEventListener('kosovi-cart', showCount);
</script>

<style>
  .site-header.shop {
    background: var(--color-shop-header);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand nav'
      'name name';
    gap: var(--space-3) var(--gap);
    align-items: baseline;
    padding-block: clamp(1.75rem, 3.8vw, 3.6rem) clamp(0.9rem, 1.9vw, 1.8rem);
  }

  .brand {
    grid-area: brand;
  }

  .name {
    grid-area: name;
  }

  nav {
    grid-area: nav;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) clamp(1rem, 4.3vw, 4.5rem);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
  }

  /* As tall as the capitals beside it, from their top to the baseline: an
     inline-block that hides its overflow sits with its bottom edge on the
     baseline in every browser. Inter's capitals are 0.727 em tall; the number
     inside is 0.6 em, so the box is 0.727 / 0.6 of its own em. */
  .badge {
    display: inline-block;
    overflow: hidden;
    vertical-align: baseline;
    min-width: calc(0.727em / 0.6);
    height: calc(0.727em / 0.6);
    margin-inline-start: 0.45em;
    padding-inline: 0.25em;
    border-radius: 0.2em;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.6em;
    line-height: calc(0.727em / 0.6);
    letter-spacing: 0;
    text-align: center;
  }

  /* Where the browser can trim the line to the figure's own height (from the
     top of the capitals to the baseline), centre the figure by padding alone,
     so it does not depend on how a browser rounds the font's line metrics. */
  @supports (text-box: trim-both cap alphabetic) {
    .badge {
      padding-block: calc((0.727em / 0.6 - 0.727em) / 2);
      line-height: 1;
      text-box: trim-both cap alphabetic;
    }
  }

  .badge[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: var(--label-start) 1fr auto;
      grid-template-areas: 'brand name nav';
      column-gap: 0;
    }
  }
</style>
