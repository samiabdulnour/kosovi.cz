---
// Brand on the left, the page title on the label line, navigation on the right.
import { getLine } from '../config/lines';
import { studio } from '../config/site';
import { collectionPath, pathOf, type Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { cz } from '../lib/typography';

interface Props {
  lang: Lang;
  alternates: Alternates;
  /** Page title shown in the middle of the bar. */
  label?: string;
  /** False when the page has its own <h1> (product pages). */
  labelIsHeading?: boolean;
}

const { lang, alternates, label, labelIsHeading = true } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const switchPath = alternates[otherLang] ?? pathOf('home', otherLang);
const blueWhite = getLine('spolecna');

const current = Astro.url.pathname;
const inShop = [pathOf('collections', lang), '/produkt/'].some((p) => current.startsWith(withBase(p)));

const items: { href: string; label: string; current: boolean }[] = [
  { href: collectionPath(blueWhite.slug[lang], lang), label: t('nav.shop'), current: inShop },
  { href: pathOf('about', lang), label: t('nav.about'), current: false },
  ...(lang === 'cs' ? [{ href: pathOf('courses', 'cs'), label: t('nav.courses'), current: false }] : []),
  { href: pathOf('contact', lang), label: t('nav.contact'), current: false },
].map((item) => ({ ...item, current: item.current || current === withBase(item.href) }));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase(pathOf('home', lang))}>{cz(studio.brand)}</a>
    {label && (labelIsHeading ? <h1 class="label">{cz(label)}</h1> : <p class="label">{cz(label)}</p>)}
    <nav aria-label={t('nav.label')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase(switchPath)} hreflang={otherLang} lang={otherLang}>
            <span aria-hidden="true">{otherLang.toUpperCase()}</span>
            <span class="visually-hidden">{t('lang.switch')}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand nav'
      'label label';
    gap: var(--space-4) var(--gap);
    align-items: baseline;
    padding-block: var(--space-6) var(--space-7);
  }

  .brand {
    grid-area: brand;
  }

  .label {
    grid-area: label;
  }

  nav {
    grid-area: nav;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2) clamp(1rem, 4vw, 4rem);
    padding: 0;
    list-style: none;
  }

  [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .bar {
      grid-template-columns: var(--label-start) 1fr auto;
      grid-template-areas: 'brand label nav';
      column-gap: 0;
    }
  }
</style>
