---
// Three columns as in the design: address, contacts, rights. The legal links
// and the language switch are not in the design, but the site needs them.
import { pathOf, type Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { studio } from '../config/site';
import { cz, telHref } from '../lib/typography';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const switchPath = alternates[otherLang] ?? pathOf('home', otherLang);

const legal = [
  { label: t('footer.terms'), path: pathOf('terms', 'cs') },
  { label: t('footer.privacy'), path: pathOf('privacy', 'cs') },
  { label: t('footer.returns'), path: pathOf('returns', 'cs') },
];
---

<footer class="site-footer">
  <div class="wrap cols">
    <address>
      {cz(studio.name)}<br />
      {studio.address.street}<br />
      {cz(`${studio.address.postalCode} ${studio.address.city}`)}
    </address>
    <p>
      {
        studio.phones.map((phone) => (
          <>
            <a href={telHref(phone)}>{cz(phone)}</a>
            <br />
          </>
        ))
      }
      <a href={`mailto:${studio.email}`}>{studio.email}</a><br />
      {studio.instagram ? <a href={`https://www.instagram.com/${studio.instagram}/`}>IG</a> : <span title="TODO(fakta): účet na Instagramu">IG</span>}
    </p>
    <div>
      <p>{t('footer.rights')} {year}</p>
      <nav aria-label={t('footer.legal')}>
        <ul>
          {
            legal.map(({ label, path }) => (
              <li>
                <a href={withBase(path)} hreflang={lang === 'cs' ? undefined : 'cs'}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="lang">
        <a href={withBase(switchPath)} hreflang={otherLang} lang={otherLang}>{t('lang.switch')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-4) var(--space-7);
    border-top: 1px solid var(--color-line);
  }

  .cols {
    display: grid;
    gap: var(--space-5) var(--gap);
  }

  address {
    font-style: normal;
  }

  ul {
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .lang {
    margin-block-start: var(--space-4);
  }

  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: var(--label-start) 1fr auto;
      column-gap: 0;
    }
  }
</style>
