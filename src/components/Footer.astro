---
// Four columns on the e-shop menu's lines (Sami, November 2026): the studio's
// name and Instagram; the e-mail and the phones; the note on visits and the
// address; the rights with the language switch. A size smaller than the rest
// of the site. The legal links come back once their pages have text.
import { pathOf, type Alternates } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';
import { studio } from '../config/site';
import { cz, telHref } from '../lib/typography';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const otherLang: Lang = lang === 'cs' ? 'en' : 'cs';
const switchPath = alternates[otherLang] ?? pathOf('home', otherLang);
// the mobile first, then the landline (Sami, November 2026)
const phones = [...studio.phones].reverse();
// as on Kontakt, on two lines, the address on the third (Sami, November 2026)
const visits = {
  cs: ['Návštěva dílny je možná pouze', 'po telefonickém dohovoru'],
  en: ['Visits to the workshop', 'by arrangement on the phone only'],
}[lang];
const typeset = (s: string) => (lang === 'cs' ? cz(s) : s);
---

<footer class="site-footer">
  <div class="wrap cols">
    <p>
      {cz(studio.name)}<br />
      {
        studio.instagram ? (
          <a href={`https://www.instagram.com/${studio.instagram}/`}>
            IG<span class="visually-hidden">, Instagram</span>
          </a>
        ) : (
          <span title="TODO(fakta): účet na Instagramu">IG</span>
        )
      }
    </p>
    <p>
      <a href={`mailto:${studio.email}`}>{studio.email}</a>
      {
        phones.map((phone) => (
          <>
            <br />
            <a href={telHref(phone)}>{cz(phone)}</a>
          </>
        ))
      }
    </p>
    <address>
      {typeset(visits[0])}<br />
      {typeset(visits[1])}<br />
      {cz(`${studio.address.street}, ${studio.address.postalCode} ${studio.address.city}`)}
    </address>
    <div>
      <p>{t('footer.rights')} {year}</p>
      <p class="lang">
        <a href={withBase(switchPath)} hreflang={otherLang} lang={otherLang}>{t('lang.switch')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-4) var(--space-7);
    border-top: 1px solid var(--color-line);
    font-size: var(--step-footer);
  }

  .cols {
    display: grid;
    gap: var(--space-5) var(--gap);
  }

  address {
    font-style: normal;
  }

  .lang {
    margin-block-start: var(--space-4);
  }

  /* Two columns on tablets, four on wide screens, the rights at the right. */
  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: var(--label-start) 1fr;
      column-gap: 0;
    }

    .cols > * {
      padding-inline-end: var(--gap);
    }
  }

  @media (min-width: 70rem) {
    .cols {
      grid-template-columns: var(--label-start) var(--label-start) 1fr auto;
    }

    .cols > :last-child {
      padding-inline-end: 0;
    }
  }
</style>
