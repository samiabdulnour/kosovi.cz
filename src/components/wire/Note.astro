---
// Annotation for Sami in the structural preview: what goes here, what is
// missing. Hidden with the "Skrýt poznámky" button in the preview bar.
// Remove all notes before launch (phase 7).
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="note" aria-label="Poznámka k náhledu">
  {title && <p class="note-title">{title}</p>}
  <slot />
</aside>

<style>
  .note {
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-note-line);
    background: var(--color-note);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .note-title {
    font-weight: 700;
  }

  .note :global(* + *) {
    margin-block-start: var(--space-2);
  }

  .note :global(ul) {
    padding-inline-start: 1.2em;
  }

  :global(html[data-notes='off']) .note {
    display: none;
  }
</style>
