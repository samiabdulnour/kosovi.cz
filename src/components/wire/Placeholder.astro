---
// Grey box that stands in for a photo or video until real imagery exists.
interface Props {
  label: string;
  ratio?: string;
  kind?: 'foto' | 'video';
}

const { label, ratio = '4 / 3', kind = 'foto' } = Astro.props;
const prefix = kind === 'video' ? 'Video' : 'Foto';
---

<div class="placeholder" role="img" aria-label={`${prefix}: ${label}`} style={`aspect-ratio: ${ratio}`}>
  <span>{prefix}: {label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    padding: var(--space-4);
    background:
      linear-gradient(to top right, transparent calc(50% - 0.5px), var(--color-line) 50%, transparent calc(50% + 0.5px)),
      linear-gradient(to bottom right, transparent calc(50% - 0.5px), var(--color-line) 50%, transparent calc(50% + 0.5px)),
      var(--color-wire);
    color: var(--color-wire-ink);
    font-size: var(--step--1);
    text-align: center;
  }

  span {
    padding: var(--space-1) var(--space-2);
    background: var(--color-wire);
  }
</style>
