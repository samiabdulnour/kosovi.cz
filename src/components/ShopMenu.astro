---
// E-shop menu of the blue-and-white line, on an ochre band across the whole
// width (Sami's screen, November 2026, after kosovi_eshop_2.pdf): the line's
// name at the left and the note on sizes at the right on one line; under them
// the tabs as a list in the first listing column, the open one underlined,
// and from the second column to the screen's edge the open tab's kinds as
// white line drawings to scale on a floor line, a solid top line and dashed
// 10 cm lines with their figures just under them at the left, the name and
// size under each drawing. The chosen kind is filled dark blue. The size is
// the menu's own where it has one, else the height in the product data (the
// diameter where there is no height), rounded to whole centimetres.
// A tab without drawings lists its kinds as text.
import type { Line, MenuGroup, MenuItem } from '../config/lines';
import { collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { kindSize } from '../lib/sizes';
import { silhouette } from '../lib/silhouettes';
import { cz } from '../lib/typography';

interface Props {
  line: Line;
  lang: Lang;
  /** The open menu entry: a tab or a kind under it. */
  entry?: MenuItem;
}

const { line, lang, entry } = Astro.props;
const href = (item: MenuItem) => withBase(collectionPath(line.slug[lang], lang, item.slug));
const group: MenuGroup | undefined = line.menu.find(
  (g) => g.slug === entry?.slug || g.items.some((i) => i.slug === entry?.slug),
);

// Chart geometry in centimetres (the screen draws 1 cm as 8.9 px at 1512).
const GUTTER = 3.6; // room for the ruler's figures before the first drawing
const TAIL = 4; // the row ends this much short of the screen's edge

const drawn = await Promise.all(
  (group?.items ?? [])
    .filter((item) => item.silhouette)
    .map(async (item) => {
      const shape = silhouette(item.silhouette!);
      // centred on the body's axis, so the column holds the wider side twice
      const reach = Math.max(shape.axis, shape.w - shape.axis);
      // the narrowest column that holds the piece; the columns then share out
      // the rest of the chart's width
      return { item, shape, size: await kindSize(line.key, item), column: 2 * reach + 2 };
    }),
);
const total = GUTTER + TAIL + drawn.reduce((sum, d) => sum + d.column, 0);
const tallest = Math.max(0, ...drawn.map((d) => d.shape.h));
const top = Math.max(20, Math.ceil((tallest + 2) / 10) * 10);
const marks = Array.from({ length: top / 10 + 1 }, (_, i) => i * 10);
const note = 'Všechny míry jsou pouze orientační, každý kus je originální, a proto se jejich velikosti můžou lišit.';
const tabHref = (g: MenuGroup) => withBase(collectionPath(line.slug[lang], lang, g.slug));
// A long tab name on two lines, as on Sami's screen: "Cukřenky / a mlíčenky"
// ("Misky a mísy" is short enough for one).
const tabLines = (name: string) => {
  const and = name.indexOf(' a ');
  return name.length > 14 && and > 0 ? [name.slice(0, and), name.slice(and + 1)] : [name];
};
---

<div class="shop-band">
  <div class="wrap band">
    <div class="head">
      <h1 class="line-name">
        {line.name[lang]}
        {entry && <span class="visually-hidden">, {entry.name}</span>}
      </h1>
      {group && drawn.length > 0 && <p class="note">{cz(note)}</p>}
    </div>

    <div class="body">
      <nav class="tabs" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
        <ul role="list">
          {
            line.menu.map((g) => (
              <li class:list={{ apart: g.slug === 'ostatni' }}>
                <a href={tabHref(g)} aria-current={g === group ? (g.slug === entry?.slug ? 'page' : 'true') : undefined}>
                  {tabLines(g.name).map((l, i) => (
                    <>
                      {i > 0 && <br />}
                      {cz(l)}
                    </>
                  ))}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        group && drawn.length > 0 && (
          <div class="chart" style={`--total: ${total.toFixed(2)}; --top: ${top}; --lead: ${GUTTER}; --tail: ${TAIL}; --n: ${drawn.length}`}>
            <div
              class="scroll"
              role="region"
              tabindex="0"
              aria-label={lang === 'cs' ? `Velikosti: ${group.name}` : `Sizes: ${group.name}`}
            >
              <div class="body-chart">
                {marks.map((cm) => (
                  <span class:list={['line', { dashed: cm > 0 && cm < top }]} style={`--at: ${cm}`} aria-hidden="true" />
                ))}
                {marks
                  .filter((cm) => cm > 0)
                  .map((cm) => (
                    <span class="mark" style={`--at: ${cm}`} aria-hidden="true">
                      {cz(`${cm} cm`)}
                    </span>
                  ))}
                <ul class="items" role="list">
                  {drawn.map(({ item, shape, size, column }) => (
                    <li style={`--col: ${column.toFixed(2)}`}>
                      <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                        <span
                          class="drawing"
                          style={`--w: ${shape.w}; --h: ${shape.h}; --shift: ${(shape.w / 2 - shape.axis).toFixed(3)}`}
                          set:html={shape.svg}
                        />
                        <span class="label">
                          <span class="name">{item.name}</span>
                          {size && <span class="size">{cz(size)}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        )
      }

      {
        group && drawn.length === 0 && group.items.length > 0 && (
          <ul class="list" role="list">
            {group.items.map((item) => (
              <li>
                <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</div>

<style>
  /* Across the whole width, in the ochre of the photos' backdrops. */
  .shop-band {
    --band: var(--color-ochre);
    background: var(--band);
    color: #fff;
    overflow-x: clip;
  }

  .band {
    padding-block: clamp(1.5rem, 3.1vw, 2.9rem) clamp(2.5rem, 6vw, 5.75rem);
  }

  .shop-band a {
    color: inherit;
    text-decoration: none;
  }

  .shop-band a:hover,
  .tabs [aria-current],
  .list [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* The line's name at the left, the note on sizes at the right. */
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
  }

  .line-name {
    font-size: inherit;
  }

  .note {
    max-width: 38rem;
    font-family: var(--font-serif);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .body {
    display: grid;
    gap: var(--space-6) 0;
    margin-block-start: clamp(2rem, 3.5vw, 3.3rem);
  }

  /* The tabs one under another, the long names on two lines, Ostatní a line
     apart (Sami's screen). */
  .tabs ul,
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabs ul {
    line-height: 1.5;
  }

  .tabs .apart {
    margin-block-start: 1.5em;
  }

  .list {
    display: grid;
    align-content: start;
    line-height: 1.5;
  }

  /* From tablets up: the tabs in the first listing column, just under the
     chart's top line; the chart from the second column to the screen's edge. */
  @media (min-width: 48rem) {
    .body {
      --bleed: max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
      grid-template-columns: 20.15% minmax(0, 1fr);
    }

    .tabs,
    .list {
      padding-block-start: 0.55rem;
    }

    .chart {
      margin-inline-end: calc(-1 * var(--bleed));
    }
  }

  /* --- size chart ------------------------------------------------------- */

  .chart {
    /* 1 cm on screen: 8.9 px at 1512 and in step with the page, smaller where
       the row would not fit (the ruler then still reads true), never too
       small to read; on phones the chart scrolls sideways. */
    container-type: inline-size;
    --label-h: 3rem;
  }

  .scroll {
    --cm: max(4.4px, min(0.589vw, 100cqw / var(--total)));
    overflow-x: auto;
  }

  /* never so narrow that a column cannot hold its label (phones scroll) */
  .body-chart {
    position: relative;
    width: max(calc(var(--total) * var(--cm)), calc(var(--n) * 5.5rem + 2.25rem));
    min-width: 100%;
    height: calc(var(--top) * var(--cm) + var(--label-h));
  }

  /* White lines: the floor and the top solid, the 10 cm steps dashed; 1px under
     the mark, so the top line stays inside the scroll box. */
  .line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--label-h) + var(--at) * var(--cm) - 1px);
    height: 1px;
    background: #fff;
  }

  .line.dashed {
    background: repeating-linear-gradient(to right, #fff 0 4px, transparent 4px 8px);
  }

  /* each figure just under its line, at the chart's left */
  .mark {
    position: absolute;
    top: calc(100% - var(--label-h) - var(--at) * var(--cm) + 0.45rem);
    left: 0.15rem;
    font-size: 0.625rem;
    line-height: 1;
    white-space: nowrap;
  }

  /* each column as wide as its piece needs, plus an equal share of the rest */
  .items {
    position: relative;
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0 calc(var(--tail) * var(--cm)) 0 max(calc(var(--lead) * var(--cm)), 2.25rem);
    list-style: none;
  }

  .items li {
    flex: 1 1 calc(var(--col) * var(--cm));
    display: flex;
  }

  .items a {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr var(--label-h);
    justify-items: center;
    align-items: end;
  }

  .items a:hover {
    text-decoration: none;
  }

  /* The body's axis on the column's centre, over the label. White outlines on
     the band's colour, so the lines behind a piece do not show through it. */
  .drawing {
    display: block;
    width: calc(var(--w) * var(--cm));
    height: calc(var(--h) * var(--cm));
    color: #fff;
    transform: translateX(calc(var(--shift) * var(--cm)));
  }

  .drawing :global(.f),
  .drawing :global(.i) {
    fill: var(--band);
  }

  /* The chosen kind is filled dark blue; pointing at a kind shows the same.
     Its inside (the opening of a cup, the espresso saucer) keeps the band's
     colour (Sami, November 2026). */
  .items a[aria-current='page'] .drawing :global(.f),
  .items a:hover .drawing :global(.f) {
    fill: var(--color-select);
  }

  .drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* name and size close under the floor, as on the screen */
  .label {
    align-self: start;
    display: grid;
    padding-block-start: 0.7rem;
    font-size: 0.6875rem;
    line-height: 1.1;
    text-align: center;
  }
</style>
