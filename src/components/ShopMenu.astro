---
// E-shop menu of the blue-and-white line, on an ochre band across the whole
// width, after kosovi_eshop_vektory.pdf (Sami, November 2026): the line's name
// at the left and the note on sizes at the right on one line; the tabs as a
// list at the left, the open one underlined; from the ruler to the screen's
// edge the open tab's kinds as white line drawings to scale, each where the
// PDF puts it (data-x in its SVG), standing on a floor line, with short 10,
// 20 and 30 cm ticks at the left. The name and, where the data has it, the
// size sit under each drawing (Sami, November 2026); kinds sold as a set
// (Jídelní soupravy) share a line and a name over theirs.
// The chosen kind is filled dark blue. The size is the menu's own where it
// has one, else the height in the product data (the diameter where there is
// no height), rounded to whole centimetres.
// A tab without drawings lists its kinds as text. On the line's first listing,
// with no tab open, the ruler and the floor stand empty until the pointer
// shows a tab's drawings on them (Sami, November 2026).
// On tablets the tabs stand in one row, like the header's menu, and the chart
// under them runs across the whole width, at one scale for every tab so the
// widest tab's drawings fit; on phones there are no drawings, the open tab's
// kinds stand as text in a second column beside the tabs (Sami, November 2026).
import { listEntries, type Line, type MenuGroup, type MenuItem } from '../config/lines';
import { collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { kindSize } from '../lib/sizes';
import { silhouette } from '../lib/silhouettes';
import { cz } from '../lib/typography';

interface Props {
  line: Line;
  lang: Lang;
  /** The open menu entry: a tab or a kind under it. */
  entry?: MenuItem;
}

const { line, lang, entry } = Astro.props;
const href = (item: MenuItem) => withBase(collectionPath(line.slug[lang], lang, item.slug));
const group: MenuGroup | undefined = line.menu.find(
  (g) => g.slug === entry?.slug || g.items.some((i) => i.slug === entry?.slug),
);

// Chart geometry in centimetres: 1 cm is 8.88 px at 1512 (the PDF's ruler).
const TOP = 30; // the ruler's height
const TICK = 3.23; // the ticks' length

// A label on two lines as in the PDF: "Konev rovná / velká 23 cm"; a
// two-word name keeps its line and the size goes under it.
const labelLines = (name: string, size?: string) => {
  const words = name.split(' ');
  if (words.length < 3) return size ? [name, size] : [name];
  return [words.slice(0, -1).join(' '), [words.at(-1), size].filter(Boolean).join(' ')];
};
const marks = [10, 20, TOP];

// Every tab's chart is on the page: the open tab's shows, and pointing at
// another tab shows its chart instead until the pointer leaves the band
// (Sami, November 2026).
const charts = await Promise.all(
  line.menu.map(async (g) => {
    const drawn = await Promise.all(
      g.items
        .filter((item) => item.silhouette)
        .map(async (item) => ({ item, shape: silhouette(item.silhouette!), size: await kindSize(line.key, item) })),
    );
    const extent = Math.max(0, ...drawn.map((d) => d.shape.x + d.shape.w)) + 2;
    // a set's line runs 6 cm beyond the axes of its outer pieces, its name centred over it
    const inSet = new Set(g.sets?.flatMap((s) => s.items) ?? []);
    const sets = (g.sets ?? [])
      .map((s) => {
        const axes = drawn.filter((d) => s.items.includes(d.item.slug)).map((d) => d.shape.x + d.shape.axis);
        return axes.length ? { name: s.name, from: Math.min(...axes) - 6, to: Math.max(...axes) + 6 } : undefined;
      })
      .filter((s) => s !== undefined);
    // where the first drawing starts, for the tablets' chart (lined up with the tabs)
    const minX = drawn.length ? Math.min(...drawn.map((d) => d.shape.x)) : 0;
    return { group: g, drawn, extent, minX, inSet, sets };
  }),
);
const hasCharts = charts.some((c) => c.drawn.length > 0);
// On computers the chart starts at the page's margin and its drawings from
// about 11 cm in, the gaps between them a little wider than in the PDF, so the
// widest tab (the teapots) reaches the screen's edge (Sami's screen, November
// 2026). Positions in cm from the page's margin.
const DESK_START = 11;
const DESK_SPREAD = 1.12;
const deskX = (x: number, minX: number) => (DESK_START + (x - minX) * DESK_SPREAD).toFixed(2);
// the widest tab's chart, from its first drawing on, sets the tablets' scale,
// the same for every tab
const maxSpan = Math.max(0, ...charts.filter((c) => c.drawn.length > 0).map((c) => c.extent - c.minX));
const note = 'Všechny míry jsou pouze orientační, každý kus je originální, a proto se jejich velikosti můžou lišit.';
const tabHref = (g: MenuGroup) => withBase(collectionPath(line.slug[lang], lang, g.slug));
// A long tab name on two lines, as on Sami's screen: "Cukřenky / a mlíčenky"
// ("Misky a mísy" is short enough for one).
const tabLines = (name: string) => {
  const and = name.indexOf(' a ');
  return name.length > 14 && and > 0 ? [name.slice(0, and), name.slice(and + 1)] : [name];
};
---

<div class="shop-band" data-shop-band data-current={group?.slug ?? ''} style={`--max-span: ${maxSpan.toFixed(2)}`}>
  <div class="wrap band">
    <div class="head">
      <h1 class="line-name">
        <!-- the line's name opens its first listing, the e-shop's main page (Sami, November 2026) -->
        <a href={withBase(collectionPath(line.slug[lang], lang))} aria-current={entry ? undefined : 'page'}>{line.name[lang]}</a>
        {entry && <span class="visually-hidden">, {entry.name}</span>}
      </h1>
      {hasCharts && <p class="note">{cz(note)}</p>}
    </div>

    <div class="body">
      <nav class="tabs" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
        <ul role="list">
          {
            line.menu.map((g) => (
              <li class:list={{ apart: g.slug === 'ostatni' }}>
                <a
                  href={tabHref(g)}
                  data-tab={g.slug}
                  aria-current={g === group ? (g.slug === entry?.slug ? 'page' : 'true') : undefined}
                >
                  {tabLines(g.name).map((l, i) => (
                    <>
                      {i > 0 && (
                        <>
                          {' '}
                          <br />
                        </>
                      )}
                      {cz(l)}
                    </>
                  ))}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {
        line.menu.map(
          (g) =>
            g.items.length > 0 && (
              <ul class="kinds" role="list" hidden={g !== group} aria-label={g.name}>
                {listEntries(g).map((e) => (
                  <li>
                    <a href={withBase(collectionPath(line.slug[lang], lang, e.slug))} aria-current={entry && e.kinds.includes(entry.slug) ? 'page' : undefined}>
                      {cz(e.name)}
                    </a>
                  </li>
                ))}
              </ul>
            ),
        )
      }

      {
        !group && hasCharts && (
          <div class="chart empty" data-tab-panel="" aria-hidden="true">
            <div class="plane" style={`--top: ${TOP}; --extent: 0; --tick: ${TICK}; --min-x: 0`}>
              <span class="floor" />
              {marks.map((cm) => (
                <span class="tick" style={`--at: ${cm}`}>
                  {cz(`${cm} cm`)}
                </span>
              ))}
            </div>
          </div>
        )
      }
      {
        charts.map(({ group: g, drawn, extent, minX, inSet, sets }) =>
          drawn.length > 0 ? (
            <div class="chart" data-tab-panel={g.slug} hidden={g !== group}>
              <div
                class="scroll"
                role="region"
                tabindex="0"
                aria-label={lang === 'cs' ? `Velikosti: ${g.name}` : `Sizes: ${g.name}`}
              >
                <div
                  class:list={['plane', { 'with-sets': sets.length > 0 }]}
                  style={`--top: ${TOP}; --extent: ${extent.toFixed(2)}; --tick: ${TICK}; --min-x: ${minX.toFixed(2)}`}
                >
                  <span class="floor" aria-hidden="true" />
                  {marks.map((cm) => (
                    <span class="tick" style={`--at: ${cm}`} aria-hidden="true">
                      {cz(`${cm} cm`)}
                    </span>
                  ))}
                  {sets.map((s) => (
                    <span
                      class="set"
                      style={`--from: ${s.from.toFixed(2)}; --to: ${s.to.toFixed(2)}; --dfrom: ${deskX(s.from, minX)}; --dto: ${deskX(s.to, minX)}`}
                    >
                      {s.name}
                    </span>
                  ))}
                  <ul class="items" role="list">
                    {drawn.map(({ item, shape, size }) => (
                      <li
                        class:list={{ 'in-set': inSet.has(item.slug) }}
                        style={`--x: ${shape.x}; --dx: ${deskX(shape.x, minX)}; --w: ${shape.w}; --h: ${shape.h}; --floor: ${shape.floor}; --axis: ${shape.axis}`}
                      >
                        <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                          <span class="drawing" set:html={shape.svg} />
                          <span class="label">
                            {labelLines(item.name, size).map((l) => (
                              <span>{cz(l)}</span>
                            ))}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ) : (
            g.items.length > 0 && (
              <ul class="list" role="list" data-tab-panel={g.slug} hidden={g !== group}>
                {g.items.map((item) => (
                  <li>
                    <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            )
          ),
        )
      }
    </div>
  </div>
</div>

<script>
  // Pointing at a tab (or tabbing to it) shows its chart in place of the open
  // tab's; leaving the band brings the open tab's back (Sami, November 2026).
  for (const band of document.querySelectorAll<HTMLElement>('[data-shop-band]')) {
    const panels = band.querySelectorAll<HTMLElement>('[data-tab-panel]');
    const show = (slug: string) => panels.forEach((p) => (p.hidden = p.dataset.tabPanel !== slug));
    const current = band.dataset.current ?? '';
    for (const tab of band.querySelectorAll<HTMLElement>('a[data-tab]')) {
      tab.addEventListener('mouseenter', () => show(tab.dataset.tab!));
      tab.addEventListener('focus', () => show(tab.dataset.tab!));
    }
    band.addEventListener('mouseleave', () => show(current));
    band.addEventListener('focusout', (event) => {
      if (!band.contains(event.relatedTarget as Node | null)) show(current);
    });
  }
</script>

<style>
  /* Across the whole width, in the ochre of the photos' backdrops. */
  .shop-band {
    --band: var(--color-ochre);
    background: var(--band);
    color: #fff;
    overflow-x: clip;
  }

  .band {
    padding-block: clamp(1.5rem, 3.1vw, 2.9rem) clamp(2.5rem, 6vw, 5.75rem);
  }

  .shop-band a {
    color: inherit;
    text-decoration: none;
  }

  .shop-band a:hover,
  .tabs [aria-current],
  .list [aria-current='page'],
  .kinds [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* The line's name at the left, the note on sizes at the right. */
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
  }

  .line-name {
    font-size: inherit;
  }

  .note {
    max-width: 38rem;
    font-family: var(--font-serif);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .body {
    display: grid;
    gap: var(--space-6) 0;
    margin-block-start: var(--space-5);
  }

  /* The tabs one under another, the long names on two lines, Ostatní a line
     apart (Sami's screen). */
  .tabs ul,
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabs ul {
    line-height: 1.5;
  }

  .tabs .apart {
    margin-block-start: 1.5em;
  }

  .list {
    display: grid;
    align-content: start;
    line-height: 1.5;
  }

  /* the other tabs' charts and kinds wait hidden */
  [data-tab-panel][hidden],
  .kinds[hidden] {
    display: none;
  }

  /* Tablets and phones: the footer's size (Sami, November 2026). */
  @media (max-width: 63.99rem) {
    .head,
    .tabs,
    .kinds {
      font-size: var(--step-footer);
    }
  }

  /* Phones: no drawings, which take too much room; the open tab's kinds as
     text in a second column beside the tabs, lined up with the second column
     of photos under the band; at the size of a product's name, spaced like
     the footer's lines; no note on sizes (Sami, November 2026). */
  @media (max-width: 47.99rem) {
    .body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.65rem;
    }

    .head,
    .tabs,
    .kinds {
      font-size: var(--step-0);
    }

    /* the tabs on one line each, with no gap before Ostatní, as in the
       product page's band */
    .tabs br {
      display: none;
    }

    .tabs .apart {
      margin-block-start: 0;
    }

    .chart,
    .list,
    .note {
      display: none;
    }

    .tabs ul,
    .kinds {
      line-height: var(--leading-body);
    }

    /* close under the word, clear of the next line */
    .tabs [aria-current],
    .kinds [aria-current='page'],
    .shop-band a:hover {
      text-underline-offset: 0.12em;
    }

    .kinds {
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  @media (min-width: 48rem) {
    .kinds {
      display: none;
    }
  }

  /* Tablets: the tabs in one row like the header's menu, the chart under them
     to the screen's edge, its first drawing under the tabs and the ticks near
     the screen's left edge, at one scale for every tab, so that the widest
     tab's drawings fit; the note on sizes close under the chart's labels; no
     line name (the header has it) and little room above and below, so the
     band stays narrow (Sami, November 2026). */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    /* doubled to win over the default scale below */
    .shop-band.shop-band {
      --cm: calc((100vw - var(--gutter)) / var(--max-span));
      --label-h: 2.75rem;
    }

    .plane.with-sets {
      --label-h: 4.4rem;
    }

    .band.band {
      display: flex;
      flex-direction: column;
      padding-block: 1.25rem 1.25rem;
    }

    .head {
      display: contents;
    }

    /* there for screen readers only */
    .line-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .body {
      order: 2;
      gap: var(--space-4);
      margin-block-start: 0;
    }

    .note {
      order: 3;
      margin-block-start: var(--space-2);
    }

    /* the empty ruler of the first listing has no labels under its floor */
    .chart.empty .plane {
      height: calc(var(--top) * var(--cm) + 0.5rem);
    }

    .chart .scroll {
      overflow: visible;
    }

    .plane.plane {
      width: calc(100% + var(--min-x) * var(--cm));
      margin-inline-start: calc(-1 * var(--min-x) * var(--cm));
    }

    /* half a rem from the screen's left edge, whatever the tab */
    .plane .tick,
    .plane .floor {
      left: calc(var(--min-x) * var(--cm) - var(--gutter) + 0.5rem);
    }

    .tabs ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) clamp(1rem, 3.9vw, 3.7rem);
      line-height: normal;
    }

    .tabs .apart {
      margin-block-start: 0;
    }

    .tabs br {
      display: none;
    }

    .chart,
    .list {
      margin-inline-end: calc(-1 * var(--gutter));
    }

    .plane .label,
    .plane .set {
      font-size: 0.6rem;
    }
  }

  /* From small laptops up, as in the PDF at 1512: the ruler 197 points right
     of the page's margin, 30 cm above the floor; the line's name and the note
     on the ruler's top, the tabs from its 20 cm tick; the chart to the
     screen's edge. */
  /* Computers, after Sami's screen (November 2026): no line name (the
     header has it); the tabs in one row at the right; under them the chart
     from the page's margin to the screen's edge, the ticks at its left and the
     drawings from about 11 cm in (--dx); the note on sizes at the bottom
     left, under the labels. */
  @media (min-width: 64rem) {
    .band {
      --bleed: max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter)));
      display: flex;
      flex-direction: column;
      padding-block: 1.2vw 1.2vw;
    }

    .head {
      display: contents;
    }

    /* there for screen readers only */
    .line-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .body {
      order: 1;
      gap: 0.65vw;
      margin-block-start: 0;
    }

    .note {
      order: 2;
      max-width: none;
      margin-block-start: 1.25vw;
    }

    /* about 89 points apart at 1512, the last at the page's right margin */
    .tabs ul {
      display: flex;
      justify-content: flex-end;
      gap: var(--space-2) 5.9vw;
      line-height: normal;
    }

    .tabs .apart {
      margin-block-start: 0;
    }

    .tabs br {
      display: none;
    }

    .chart,
    .list {
      margin-inline-end: calc(-1 * var(--bleed));
    }

    .chart .scroll {
      overflow: visible;
    }

    .plane.plane {
      width: 100%;
    }

    .plane .tick {
      left: 0.75rem;
    }

    .plane .items li {
      left: calc(var(--dx) * var(--cm));
    }

    .plane .set {
      left: calc(var(--dfrom) * var(--cm));
      width: calc((var(--dto) - var(--dfrom)) * var(--cm));
    }

    /* room under the floor for two lines of labels, more where a set's
       labels stand a step lower */
    .shop-band {
      --label-h: 2.9rem;
    }

    .plane.with-sets {
      --label-h: 4.75rem;
    }

    /* the empty ruler of the first listing has no labels under its floor */
    .chart.empty .plane {
      height: calc(var(--top) * var(--cm) + 0.5rem);
    }
  }

  /* --- size chart ------------------------------------------------------- */

  /* 1 cm on screen: 8.88 px at 1512 and in step with the page, never so
     small that the labels run into each other; narrower screens scroll the
     chart sideways. */
  .shop-band {
    --cm: max(6px, 0.5873vw);
    --label-h: 4.5rem;
  }

  .scroll {
    overflow-x: auto;
  }

  .plane {
    position: relative;
    width: max(100%, calc(var(--extent) * var(--cm)));
    height: calc(var(--top) * var(--cm) + var(--label-h));
  }

  /* the floor from the ruler to the screen's edge */
  .floor {
    position: absolute;
    top: calc(var(--top) * var(--cm));
    left: 0;
    right: 0;
    height: 1px;
    background: #fff;
  }

  /* short ticks at the left, each figure just under its tick */
  .tick {
    position: absolute;
    top: calc((var(--top) - var(--at)) * var(--cm));
    left: 0;
    width: calc(var(--tick) * var(--cm));
    padding-block-start: 0.2rem;
    border-top: 1px solid #fff;
    color: #ded8a9;
    font-size: 0.625rem;
    line-height: 1;
    white-space: nowrap;
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* each drawing where the PDF puts it, its floor point on the floor */
  .items li {
    position: absolute;
    left: calc(var(--x) * var(--cm));
    top: calc((var(--top) - var(--floor)) * var(--cm));
    width: calc(var(--w) * var(--cm));
    height: calc(var(--h) * var(--cm));
  }

  .items a {
    display: block;
    height: 100%;
  }

  .items a:hover {
    text-decoration: none;
  }

  /* White outlines on the band's colour, so the floor behind a piece does not
     show through it. */
  .drawing {
    display: block;
    height: 100%;
    color: #fff;
  }

  .drawing :global(.f),
  .drawing :global(.i) {
    fill: var(--band);
  }

  /* The chosen kind is filled dark blue; pointing at a kind shows the same.
     Its inside (the opening of a cup, the well of a plate, the espresso
     saucer) keeps the band's colour (Sami, November 2026). */
  .items a[aria-current='page'] .drawing :global(.f),
  .items a:hover .drawing :global(.f) {
    fill: var(--color-select);
  }

  .drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* name and size under the floor, centred on the body's axis; a set's pieces
     one step lower, under the set's line and name */
  .label {
    position: absolute;
    top: calc(var(--floor) * var(--cm) + 1.25rem);
    left: calc(var(--axis) * var(--cm));
    display: grid;
    transform: translateX(-50%);
    color: #fff9e3;
    font-size: 0.6875rem;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
  }

  .in-set .label {
    top: calc(var(--floor) * var(--cm) + 2.95rem);
  }

  .set {
    position: absolute;
    top: calc(var(--top) * var(--cm) + 0.75rem);
    left: calc(var(--from) * var(--cm));
    width: calc((var(--to) - var(--from)) * var(--cm));
    padding-block-start: 0.5rem;
    border-top: 1px solid #fff;
    color: #fff9e3;
    font-size: 0.6875rem;
    line-height: 1.1;
    text-align: center;
  }
</style>
