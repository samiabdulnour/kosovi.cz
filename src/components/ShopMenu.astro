---
// E-shop menu of the blue-and-white line, on an ochre band across the whole
// width (Sami's screen, November 2026, after kosovi_eshop_2.pdf): the line's
// name, its tabs as a list on the label line and the note on sizes at the
// right; under them the open tab's kinds as white line drawings to scale on a
// floor line, with a ruler every 10 cm and the name and size under each. The
// chosen kind is filled dark blue. The size is the menu's own where it has
// one, else the height in the product data (the diameter where there is no
// height), rounded to whole centimetres.
// A tab without drawings lists its kinds as text.
import type { Line, MenuGroup, MenuItem } from '../config/lines';
import { collectionPath } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { kindSize } from '../lib/sizes';
import { silhouette } from '../lib/silhouettes';
import { cz } from '../lib/typography';

interface Props {
  line: Line;
  lang: Lang;
  /** The open menu entry: a tab or a kind under it. */
  entry?: MenuItem;
}

const { line, lang, entry } = Astro.props;
const href = (item: MenuItem) => withBase(collectionPath(line.slug[lang], lang, item.slug));
const group: MenuGroup | undefined = line.menu.find(
  (g) => g.slug === entry?.slug || g.items.some((i) => i.slug === entry?.slug),
);

// Chart geometry in centimetres (the PDF draws 1 cm as 8.9 px on a 1512 px screen).
const COLUMN = 19.43; // one mug column in the PDF
const GUTTER = 11.6; // room for the ruler's labels

const drawn = await Promise.all(
  (group?.items ?? [])
    .filter((item) => item.silhouette)
    .map(async (item) => {
      const shape = silhouette(item.silhouette!);
      // centred on the body's axis, so the column holds the wider side twice
      const reach = Math.max(shape.axis, shape.w - shape.axis);
      return { item, shape, size: await kindSize(line.key, item), column: Math.max(COLUMN, 2 * reach + 2) };
    }),
);
const total = GUTTER + drawn.reduce((sum, d) => sum + d.column, 0);
const tallest = Math.max(0, ...drawn.map((d) => d.shape.h));
const top = Math.max(20, Math.ceil((tallest + 2) / 10) * 10);
const marks = Array.from({ length: top / 10 + 1 }, (_, i) => i * 10);
const note = 'Všechny míry jsou pouze orientační, každý kus je originální, a proto se jejich velikosti můžou lišit.';
const tabHref = (g: MenuGroup) => withBase(collectionPath(line.slug[lang], lang, g.slug));
---

<div class="shop-band">
  <div class="wrap band">
    <div class="head">
      <h1 class="line-name">
        {line.name[lang]}
        {entry && <span class="visually-hidden">, {entry.name}</span>}
      </h1>
      <nav class="tabs" aria-label={lang === 'cs' ? 'Kategorie' : 'Categories'}>
        <ul role="list">
          {
            line.menu.map((g) => (
              <li>
                <a href={tabHref(g)} aria-current={g === group ? (g.slug === entry?.slug ? 'page' : 'true') : undefined}>
                  {g.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {
      group && drawn.length > 0 && (
        <div class="chart" style={`--total: ${total.toFixed(2)}; --top: ${top}; --gutter: ${GUTTER}`}>
          <p class="note">{cz(note)}</p>
          <div
            class="scroll"
            role="region"
            tabindex="0"
            aria-label={lang === 'cs' ? `Velikosti: ${group.name}` : `Sizes: ${group.name}`}
          >
            <div class="body">
              {marks.map((cm) => (
                <span class:list={['line', { dashed: cm > 0 && cm < top }]} style={`--at: ${cm}`} aria-hidden="true" />
              ))}
              {marks
                .filter((cm) => cm > 0)
                .map((cm) => (
                  <span class="mark" style={`--at: ${cm}`} aria-hidden="true">
                    {cz(`${cm} cm`)}
                  </span>
                ))}
              <ul class="items" role="list">
                {drawn.map(({ item, shape, size, column }) => (
                  <li style={`--col: ${column.toFixed(2)}`}>
                    <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                      <span
                        class="drawing"
                        style={`--w: ${shape.w}; --h: ${shape.h}; --shift: ${(shape.w / 2 - shape.axis).toFixed(3)}`}
                        set:html={shape.svg}
                      />
                      <span class="label">
                        <span class="name">{item.name}</span>
                        {size && <span class="size">{cz(size)}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )
    }

    {
      group && drawn.length === 0 && group.items.length > 0 && (
        <ul class="list" role="list">
          {group.items.map((item) => (
            <li>
              <a href={href(item)} aria-current={item.slug === entry?.slug ? 'page' : undefined}>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  /* Across the whole width, in the ochre of the photos' backdrops. */
  .shop-band {
    --band: var(--color-ochre);
    background: var(--band);
    color: #fff;
  }

  .band {
    padding-block: clamp(1.5rem, 2.4vw, 2.25rem) clamp(3rem, 8vw, 7.5rem);
  }

  .shop-band a {
    color: inherit;
    text-decoration: none;
  }

  .shop-band a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* The line's name at the left, the tabs on the label line; stacked on
     phones. */
  .head {
    display: grid;
    gap: var(--space-4) 0;
    align-items: start;
  }

  .line-name {
    font-size: inherit;
  }

  .tabs ul,
  .list {
    display: grid;
    row-gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The open tab is not marked (Sami's screen: the drawings show it); the
     chosen kind in a tab without drawings is underlined. */
  .list [aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* The note on sizes just above the chart's top line, at the right (Sami,
     November 2026); on phones over the chart, which scrolls sideways. */
  .note {
    margin-block-end: var(--space-3);
    font-family: var(--font-serif);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (min-width: 48rem) {
    .head {
      grid-template-columns: var(--label-start) auto 1fr;
    }

    .chart {
      position: relative;
    }

    .note {
      position: absolute;
      right: 0;
      bottom: calc(100% + 0.55rem);
      max-width: 34rem;
      margin: 0;
      text-align: right;
    }

    /* a tab without drawings lists its kinds under the tabs, on the label line */
    .list {
      margin-inline-start: var(--label-start);
    }
  }

  .list {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }

  /* --- size chart ------------------------------------------------------- */

  .chart {
    /* 1 cm on screen: as in the PDF where the row fits, smaller where it would
       not (the ruler then still reads true), never too small to read. */
    container-type: inline-size;
    --label-h: 3rem;
    margin-block-start: clamp(2.5rem, 6vw, 5.75rem);
  }

  .scroll {
    --cm: max(4.4px, min(9.4px, 100cqw / var(--total)));
    overflow-x: auto;
  }

  .body {
    position: relative;
    width: calc(var(--total) * var(--cm));
    min-width: 100%;
    height: calc(var(--top) * var(--cm) + var(--label-h));
  }

  /* White lines: the floor and the top solid, the 10 cm steps dashed; 1px under
     the mark, so the top line stays inside the scroll box. */
  .line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--label-h) + var(--at) * var(--cm) - 1px);
    height: 1px;
    background: #fff;
  }

  .line.dashed {
    background: repeating-linear-gradient(to right, #fff 0 4px, transparent 4px 8px);
  }

  /* the ruler's figures, each in the middle of its 10 cm */
  .mark {
    position: absolute;
    top: calc(100% - var(--label-h) - (var(--at) - 5) * var(--cm));
    left: 0.6rem;
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .items {
    position: relative;
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0 0 0 calc(var(--gutter) * var(--cm));
    list-style: none;
  }

  .items li {
    flex: none;
    display: flex;
    width: calc(var(--col) * var(--cm));
  }

  .items a {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr var(--label-h);
    justify-items: center;
    align-items: end;
  }

  .items a:hover {
    text-decoration: none;
  }

  /* The body's axis on the column's centre, over the label. White outlines on
     the band's colour, so the lines behind a piece do not show through it. */
  .drawing {
    display: block;
    width: calc(var(--w) * var(--cm));
    height: calc(var(--h) * var(--cm));
    color: #fff;
    transform: translateX(calc(var(--shift) * var(--cm)));
  }

  .drawing :global(.f),
  .drawing :global(.i) {
    fill: var(--band);
  }

  /* The chosen kind is filled dark blue; pointing at a kind shows the same.
     Its inside (the opening of a cup, the espresso saucer) keeps the band's
     colour (Sami, November 2026). */
  .items a[aria-current='page'] .drawing :global(.f),
  .items a:hover .drawing :global(.f) {
    fill: var(--color-select);
  }

  .drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .label {
    align-self: start;
    display: grid;
    row-gap: 0.2em;
    padding-block-start: 0.85rem;
    font-size: 0.6875rem;
    line-height: 1.3;
    text-align: center;
  }
</style>
