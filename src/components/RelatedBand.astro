---
// Pieces on a green band across the whole width, five tiles as in the listing,
// each group under its heading; on phones two a row. Under a product page its
// related pieces, under a listing the pieces of the other parts of the e-shop
// (src/config/crosslinks.ts, Sami, November 2026).
import ProductCard from './ProductCard.astro';
import type { Lang } from '../i18n/ui';
import type { Product } from '../lib/products';

interface Props {
  groups: { title: string; href?: string; products: Product[] }[];
  /** Names the band for screen readers. */
  label: string;
  lang: Lang;
  /** Space above the band, where the default (a product page's) is too much. */
  gap?: string;
}

const { groups, label, lang, gap } = Astro.props;
// Each heading spans its own tiles.
const shown = groups
  .filter((g) => g.products.length > 0)
  .map((g, i, all) => ({ ...g, start: 1 + all.slice(0, i).reduce((n, h) => n + h.products.length, 0) }));
---

{
  shown.length > 0 && (
    <div class="related-band" style={gap ? `--band-gap: ${gap}` : undefined}>
      <div class="wrap">
        <section class="related" aria-label={label}>
          {shown.map((g) => (
            <>
              <h2 style={`--start: ${g.start}; --span: ${g.products.length}`}>
                {g.href ? <a href={g.href}>{g.title}</a> : g.title}
              </h2>
              {g.products.map((p) => (
                <div class="tile">
                  <ProductCard product={p} lang={lang} />
                </div>
              ))}
            </>
          ))}
        </section>
      </div>
    </div>
  )
}

<style>
  .related-band {
    margin-block-start: var(--band-gap, clamp(3.5rem, 9.2vw, 8.7rem));
    padding-block-start: 1.75rem;
    background: #96c19d;
  }

  .related {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.65rem;
  }

  .tile {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
  }

  h2 {
    grid-column: 1 / -1;
    padding-block-end: 0.75rem;
  }

  @media (min-width: 48rem) {
    .related {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    h2 {
      grid-row: 1;
      grid-column: var(--start) / span var(--span);
    }

    .tile {
      grid-row: 2 / span 2;
    }
  }
</style>
