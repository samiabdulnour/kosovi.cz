---
// Name, phones and e-mail. No street address (Sami, November 2026): the
// workshop is visited only by arrangement on the phone.
import { studio } from '../config/site';
import { cz, telHref } from '../lib/typography';
---

<address class="contact">
  <p>{cz(studio.name)}</p>
  <p>
    {
      studio.phones.map((phone, i) => (
        <>
          {i > 0 && <br />}
          <a href={telHref(phone)}>{cz(phone)}</a>
        </>
      ))
    }
    <br />
    <a href={`mailto:${studio.email}`}>{studio.email}</a>
  </p>
</address>

<style>
  .contact {
    font-style: normal;
  }

  .contact > * + * {
    margin-block-start: var(--space-3);
  }
</style>
