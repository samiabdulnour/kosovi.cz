---
// The homepage's rows of photographs (kosovi_homepage.pdf, src/config/home.ts),
// placed as in the PDF on a frame 1512 wide and scaled with the page. Each
// photograph opens its author's part of the site (Daniela's page, Martin's
// page, the blue-and-white e-shop) and shows the author's name in its top
// corner when the pointer is over it (Sami, November 2026); on touch screens,
// which have no pointer to hover, the name always shows. On phones the
// photographs stand one under another and the colour fields drop out.
// A video plays silent in a loop, unless the visitor asked for less motion;
// a button over it stops and restarts it (moving pictures need one).
import { getImage, Image } from 'astro:assets';
import { mosaicWidth, type Author, type MosaicItem, type MosaicRow } from '../config/home';
import { getLine } from '../config/lines';
import { makers } from '../config/site';
import { collectionPath, pathOf } from '../i18n/routes';
import type { Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';

interface Props {
  rows: MosaicRow[];
  lang: Lang;
}

const { rows, lang } = Astro.props;
const t = useTranslations(lang);
const blueWhite = getLine('spolecna');
const authors: Record<Author, { name: string; href: string }> = {
  daniela: { name: makers.daniela.name, href: pathOf('daniela', lang) },
  martin: { name: makers.martin.name, href: pathOf('martin', lang) },
  modrobily: { name: blueWhite.name[lang], href: collectionPath(blueWhite.slug[lang], lang) },
};

const W = mosaicWidth;
const pct = (v: number) => `${((v / W) * 100).toFixed(3)}%`;
const clampItem = (i: MosaicItem) => {
  const x = Math.max(0, i.x);
  return { x, w: Math.min(W, i.x + i.w) - x };
};
const place = (i: MosaicItem) => {
  const { x, w } = clampItem(i);
  return `--x: ${pct(x)}; --w: ${pct(w)}`;
};

// Posters for the videos, made at build time like any other image.
const posters = new Map(
  await Promise.all(
    rows
      .flatMap((row) => row.items)
      .filter((item) => item.video)
      .map(async (item) => [item, await getImage({ src: item.video!.poster, width: 576, format: 'webp' })] as const),
  ),
);
---

<div class="mosaic">
  {
    rows.map((row) => (
      <div class="row" id={row.id} style={`--h: ${row.h}`}>
        {row.items.map((item) => {
          const { w } = clampItem(item);
          if (item.video)
            return (
              <span class="photo" style={`${place(item)}; --ratio: ${w} / ${row.h}`} data-video>
                <video muted loop playsinline preload="auto" poster={posters.get(item)?.src} aria-label={item.video.label}>
                  <source src={item.video.src} type="video/mp4" />
                  {item.video.webm && <source src={item.video.webm} type="video/webm" />}
                </video>
                <button class="video-toggle" type="button" data-pause={t('video.pause')} data-play={t('video.play')}>
                  {t('video.pause')}
                </button>
              </span>
            );
          if (!item.photo) return <span class="area" style={`${place(item)}; background: ${item.color}`} aria-hidden="true" />;
          const image = (
            <Image
              src={item.photo.src}
              alt={item.photo.alt}
              widths={[480, 800, 1200, 1600, 2000].filter((x) => x <= item.photo!.src.width)}
              sizes={`(min-width: 48rem) ${Math.ceil((w / W) * 100)}vw, 100vw`}
            />
          );
          const author = item.by && authors[item.by];
          return author ? (
            <a
              class:list={['photo', { light: item.light, edge: item.x <= 1 }]}
              href={withBase(author.href)}
              style={`${place(item)}; --ratio: ${w} / ${row.h}`}
            >
              {image}
              <span class="name">{author.name}</span>
            </a>
          ) : (
            <span class="photo" style={`${place(item)}; --ratio: ${w} / ${row.h}`}>
              {image}
            </span>
          );
        })}
      </div>
    ))
  }
</div>

<style>
  /* Rows a little apart, as in the PDF (about 22 points at 1512). */
  .mosaic {
    display: grid;
    row-gap: clamp(0.75rem, 1.45vw, 1.4rem);
  }

  .row {
    display: grid;
    row-gap: clamp(0.75rem, 1.45vw, 1.4rem);
  }

  .area {
    display: none;
  }

  .photo {
    position: relative;
    display: block;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .photo :global(img),
  .photo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stop and restart: in the corner, shown with the pointer over the video or
     when focused, always on touch screens. */
  .video-toggle {
    position: absolute;
    right: clamp(0.5rem, 1vw, 0.9rem);
    bottom: clamp(0.5rem, 1vw, 0.9rem);
    padding: var(--space-1) var(--space-2);
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: calc(var(--step--1) + 2px);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  [data-video]:hover .video-toggle,
  .video-toggle:focus-visible {
    opacity: 1;
  }

  /* The author's name in the top corner, on the page's margin where the
     photograph starts at the page's edge. */
  .name {
    position: absolute;
    top: clamp(0.75rem, 1.2vw, 1.15rem);
    left: var(--gutter);
    color: var(--color-ink);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .light .name {
    color: #fff;
  }

  a.photo:hover {
    text-decoration: none;
  }

  a.photo:hover .name,
  a.photo:focus-visible .name {
    opacity: 1;
  }

  @media (hover: none) {
    .name,
    .video-toggle {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name,
    .video-toggle {
      transition: none;
    }
  }

  /* From tablets up, each row is the PDF's frame scaled to the page. */
  @media (min-width: 48rem) {
    .row {
      position: relative;
      display: block;
      aspect-ratio: 1512 / var(--h);
    }

    .area,
    .photo {
      position: absolute;
      top: 0;
      left: var(--x);
      width: var(--w);
      height: 100%;
    }

    .area {
      display: block;
    }

    .photo {
      aspect-ratio: auto;
    }

    .photo:not(.edge) .name {
      left: clamp(1rem, 1.6vw, 1.5rem);
    }
  }
</style>

<script>
  // Videos play silent in a loop, except for visitors who asked for less
  // motion; the button stops and restarts them.
  const lessMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const cell of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const video = cell.querySelector('video');
    const button = cell.querySelector<HTMLButtonElement>('.video-toggle');
    if (!video || !button) continue;
    const show = () => {
      button.textContent = (video.paused ? button.dataset.play : button.dataset.pause) ?? '';
    };
    video.addEventListener('play', show);
    video.addEventListener('pause', show);
    button.addEventListener('click', () => {
      if (video.paused) void video.play();
      else video.pause();
    });
    if (!lessMotion) video.play().catch(show);
    show();
  }
</script>
